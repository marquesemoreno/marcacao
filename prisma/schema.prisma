generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLINIC
  PATIENT

  @@map("user_role")
}

enum ProcedureCategory {
  CONSULTATION
  EXAM
  SURGERY

  @@map("procedure_category")
}

enum AppointmentType {
  SCHEDULED
  ARRIVAL_ORDER

  @@map("appointment_type")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED

  @@map("conversation_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  role         UserRole @default(PATIENT)
  passwordHash String   @map("password_hash")
  clinicId     String?  @map("clinic_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]

  @@map("users")
}

model Clinic {
  id              String   @id @default(cuid())
  name            String
  tradeName       String   @map("trade_name")
  cnpj            String   @unique
  phone           String?
  whatsapp        String?
  address         String
  neighborhood    String
  city            String
  active          Boolean  @default(true)
  commissionRate  Decimal  @map("commission_rate") @db.Decimal(5, 2)
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  businessHours   Json?    @map("business_hours")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users            User[]
  clinicProcedures ClinicProcedure[]
  conversations    Conversation[]
  cannedResponses  CannedResponse[]

  @@map("clinics")
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  procedures Procedure[]

  @@map("specialties")
}

model Procedure {
  id                      String            @id @default(cuid())
  specialtyId             String?           @map("specialty_id")
  name                    String            @unique
  category                ProcedureCategory
  description             String?
  preparationInstructions String?           @map("preparation_instructions")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  specialty        Specialty?        @relation(fields: [specialtyId], references: [id])
  clinicProcedures ClinicProcedure[]

  @@map("procedures")
}

model ClinicProcedure {
  id                  String          @id @default(cuid())
  clinicId            String          @map("clinic_id")
  procedureId         String          @map("procedure_id")
  price               Decimal         @db.Decimal(10, 2)
  promotionalPrice    Decimal?        @map("promotional_price") @db.Decimal(10, 2)
  requiresAppointment Boolean         @default(true) @map("requires_appointment")
  appointmentType     AppointmentType @default(SCHEDULED) @map("appointment_type")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  procedure    Procedure     @relation(fields: [procedureId], references: [id])
  appointments Appointment[]

  @@unique([clinicId, procedureId])
  @@map("clinic_procedures")
}

model Appointment {
  id                String            @id @default(cuid())
  patientName       String            @map("patient_name")
  patientPhone      String            @map("patient_phone")
  patientCpf        String            @map("patient_cpf")
  clinicProcedureId String            @map("clinic_procedure_id")
  date              DateTime          @db.Date
  timeSlot          String?           @map("time_slot")
  status            AppointmentStatus @default(PENDING)
  paymentMethod     String?           @map("payment_method")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  clinicProcedure ClinicProcedure @relation(fields: [clinicProcedureId], references: [id])

  @@index([clinicProcedureId, date])
  @@map("appointments")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  cpf       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("contacts")
}

model Conversation {
  id             String             @id @default(cuid())
  clinicId       String             @map("clinic_id")
  contactId      String             @map("contact_id")
  assignedUserId String?            @map("assigned_user_id")
  status         ConversationStatus @default(OPEN)
  tags           String[]           @default([])
  lastMessageAt  DateTime?          @map("last_message_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  contact      Contact   @relation(fields: [contactId], references: [id])
  assignedUser User?     @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages     Message[]

  @@index([clinicId, status])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  content        String
  status         MessageStatus    @default(PENDING)
  senderUserId   String?          @map("sender_user_id")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  senderUser   User?        @relation(fields: [senderUserId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CannedResponse {
  id        String   @id @default(cuid())
  clinicId  String?  @map("clinic_id")
  shortcut  String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, shortcut])
  @@map("canned_responses")
}

model WebhookLog {
  id           String   @id @default(cuid())
  event        String
  payload      Json
  status       String
  responseCode Int?     @map("response_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}
