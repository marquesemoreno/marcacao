generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLINIC
  PATIENT

  @@map("user_role")
}

enum ProcedureCategory {
  CONSULTATION
  EXAM
  SURGERY

  @@map("procedure_category")
}

enum AppointmentType {
  SCHEDULED
  ARRIVAL_ORDER

  @@map("appointment_type")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("appointment_status")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  role         UserRole @default(PATIENT)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Clinic {
  id              String   @id @default(cuid())
  name            String
  tradeName       String   @map("trade_name")
  cnpj            String   @unique
  phone           String?
  whatsapp        String?
  address         String
  neighborhood    String
  city            String
  active          Boolean  @default(true)
  commissionRate  Decimal  @map("commission_rate") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinicProcedures ClinicProcedure[]

  @@map("clinics")
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  procedures Procedure[]

  @@map("specialties")
}

model Procedure {
  id                      String            @id @default(cuid())
  specialtyId             String?           @map("specialty_id")
  name                    String            @unique
  category                ProcedureCategory
  description             String?
  preparationInstructions String?           @map("preparation_instructions")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  specialty        Specialty?        @relation(fields: [specialtyId], references: [id])
  clinicProcedures ClinicProcedure[]

  @@map("procedures")
}

model ClinicProcedure {
  id                  String          @id @default(cuid())
  clinicId            String          @map("clinic_id")
  procedureId         String          @map("procedure_id")
  price               Decimal         @db.Decimal(10, 2)
  promotionalPrice    Decimal?        @map("promotional_price") @db.Decimal(10, 2)
  requiresAppointment Boolean         @default(true) @map("requires_appointment")
  appointmentType     AppointmentType @default(SCHEDULED) @map("appointment_type")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  procedure    Procedure     @relation(fields: [procedureId], references: [id])
  appointments Appointment[]

  @@unique([clinicId, procedureId])
  @@map("clinic_procedures")
}

model Appointment {
  id                String            @id @default(cuid())
  patientName       String            @map("patient_name")
  patientPhone      String            @map("patient_phone")
  patientCpf        String            @map("patient_cpf")
  clinicProcedureId String            @map("clinic_procedure_id")
  date              DateTime          @db.Date
  timeSlot          String?           @map("time_slot")
  status            AppointmentStatus @default(PENDING)
  paymentMethod     String?           @map("payment_method")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  clinicProcedure ClinicProcedure @relation(fields: [clinicProcedureId], references: [id])

  @@index([clinicProcedureId, date])
  @@map("appointments")
}

model WebhookLog {
  id           String   @id @default(cuid())
  event        String
  payload      Json
  status       String
  responseCode Int?     @map("response_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}
