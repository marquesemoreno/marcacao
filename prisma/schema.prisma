generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer/Supavisor, porta 6543) — usado em runtime. Sem isso, cada
  // invocação serverless podia abrir sua própria conexão direta e estourar o limite
  // de conexões simultâneas do Postgres sob tráfego mais alto.
  url       = env("DATABASE_URL")
  // Direta (porta 5432) — só pra migrations, que precisam de prepared statements/DDL
  // que o pgbouncer em modo transaction não suporta.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CLINIC
  PATIENT

  @@map("user_role")
}

enum ProcedureCategory {
  CONSULTATION
  EXAM
  SURGERY

  @@map("procedure_category")
}

enum AppointmentType {
  SCHEDULED
  ARRIVAL_ORDER

  @@map("appointment_type")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED

  @@map("conversation_status")
}

enum AiConsentStatus {
  NOT_ASKED
  PENDING
  ACCEPTED
  DECLINED

  @@map("ai_consent_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

enum PartnerLeadStatus {
  NEW
  CONTACTED
  PARTNER
  REJECTED

  @@map("partner_lead_status")
}

enum PixKeyType {
  CPF
  EMAIL
  PHONE
  RANDOM

  @@map("pix_key_type")
}

enum AffiliateStatus {
  ACTIVE
  PENDING
  SUSPENDED

  @@map("affiliate_status")
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  WEBCHAT

  @@map("conversation_channel")
}

enum ConversationDepartment {
  RECEPCAO
  AGENDAMENTO
  FINANCEIRO

  @@map("conversation_department")
}

enum ConversationFunnelStage {
  NOVOS
  TRIAGEM
  ORCAMENTO
  AGENDADO

  @@map("conversation_funnel_stage")
}

enum MessageType {
  TEXT
  AUDIO
  INTERNAL_NOTE
  ATTACHMENT

  @@map("message_type")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  role               UserRole @default(PATIENT)
  passwordHash       String   @map("password_hash")
  clinicId           String?  @map("clinic_id")
  maxConcurrentChats Int      @default(5) @map("max_concurrent_chats")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]

  @@map("users")
}

model Clinic {
  id                    String   @id @default(cuid())
  name                  String
  tradeName             String   @map("trade_name")
  cnpj                  String   @unique
  phone                 String?
  whatsapp              String?
  address               String
  neighborhood          String
  city                  String
  active                Boolean  @default(true)
  /// Clínicas parceiras que usam só o CRM/WhatsApp (ex: modelo "ferramenta
  /// grátis + comissão por agendamento concluído") mas não têm vitrine no
  /// marketplace público — não aparecem em busca, home ou /clinicas.
  listedInMarketplace   Boolean  @default(true) @map("listed_in_marketplace")
  /// Mensagem automática enviada uma única vez, no primeiro contato de um
  /// cliente novo (primeira Conversation dele com essa clínica). Cada clínica
  /// liga/desliga e escreve a sua — não dispara em conversas já existentes,
  /// mesmo resolvidas, pra não parecer robótico com quem já é conhecido.
  welcomeMessageEnabled Boolean  @default(false) @map("welcome_message_enabled")
  welcomeMessageText    String?  @map("welcome_message_text")
  commissionRate        Decimal  @map("commission_rate") @db.Decimal(5, 2)
  rating                Float    @default(0)
  reviewCount           Int      @default(0) @map("review_count")
  businessHours         Json?    @map("business_hours")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users               User[]
  clinicProcedures    ClinicProcedure[]
  conversations       Conversation[]
  cannedResponses     CannedResponse[]
  whatsappInstance    WhatsappInstance?
  hospitalIntegration HospitalIntegration?
  aiAttendantConfig   AiAttendantConfig?
  broadcastCampaigns  BroadcastCampaign[]
  bridgeReminderLogs  BridgeReminderLog[]
  knowledgeEntries    ClinicKnowledgeEntry[]

  @@map("clinics")
}

enum WhatsappInstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED

  @@map("whatsapp_instance_status")
}

/// Instância Evolution API exclusiva de uma clínica (ex: Santa Clara) — usada só
/// no atendimento humano via chat, nunca nas automações de agendamento do
/// marketplace (que continuam sempre na instância global via env vars).
model WhatsappInstance {
  id            String                 @id @default(cuid())
  clinicId      String                 @unique @map("clinic_id")
  apiUrl        String                 @map("api_url")
  apiKey        String                 @map("api_key")
  instanceName  String                 @unique @map("instance_name")
  status        WhatsappInstanceStatus @default(DISCONNECTED)
  lastCheckedAt DateTime?              @map("last_checked_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("whatsapp_instances")
}

/// Config da integração com o sistema hospitalar da clínica (bridge Node.js que fala
/// com o banco Firebird dela) — uma linha por clínica, editável via /admin/clinicas.
/// Presença + `active: true` é o sinal de "essa clínica usa o bridge, não o catálogo
/// do marketplace" (ver hasHospitalBridgeIntegration em src/lib/hospital-bridge.ts).
model HospitalIntegration {
  id            String    @id @default(cuid())
  clinicId      String    @unique @map("clinic_id")
  apiUrl        String    @map("api_url")
  apiToken      String    @map("api_token")
  active        Boolean   @default(true)
  /// Quando true, o lembrete D-1 pula sábado/domingo como dia-alvo e joga pro
  /// próximo dia útil (ex: sexta manda lembrete de segunda, não de sábado) — pra
  /// clínicas que não atendem fim de semana. Ver nextReminderTargetDate em
  /// bridge-reminder.ts. Default false: não muda o comportamento de clínica nenhuma
  /// só por existir a coluna.
  skipWeekendReminders Boolean   @default(false) @map("skip_weekend_reminders")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastCheckOk   Boolean?  @map("last_check_ok")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("hospital_integrations")
}

/// Controla quais agendamentos do bridge (Firebird) já receberam o lembrete D-1
/// automático (ver dispatchBridgeReminders) — evita mandar duplicado se o cron
/// rodar mais de uma vez no mesmo dia. bridgeNumero é o MARCACAO.NUMERO real da
/// clínica, não um id nosso.
model BridgeReminderLog {
  id           String   @id @default(cuid())
  clinicId     String   @map("clinic_id")
  bridgeNumero Int      @map("bridge_numero")
  sentAt       DateTime @default(now()) @map("sent_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, bridgeNumero])
  @@map("bridge_reminder_logs")
}

/// Config do atendente de IA da clínica (OpenAI) — uma linha por clínica, editável via
/// /admin/clinicas. `instructions` soma com um prompt-base fixo (regras de LGPD: sempre
/// se identificar como IA, nunca dar diagnóstico, sempre oferecer transferência pra
/// humano) definido em src/lib/ai-attendant.ts. Consentimento e escalação são controlados
/// por conversa (ver Conversation.aiConsentStatus/aiEnabled), não por aqui.
model AiAttendantConfig {
  id           String   @id @default(cuid())
  clinicId     String   @unique @map("clinic_id")
  active       Boolean  @default(false)
  instructions String   @db.Text
  /// Nome de exibição do atendente (ex: "Lara", "TI") — usado na mensagem de
  /// consentimento LGPD (ver buildAiDisclosureMessage) pra soar como uma
  /// apresentação, não um aviso legal seco. Sem isso, cai no texto genérico
  /// "Assistente Virtual da {clínica}".
  assistantName String? @map("assistant_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("ai_attendant_configs")
}

enum ClinicKnowledgeCategory {
  CORPO_CLINICO
  HORARIO_ATENDIMENTO
  CONVENIOS
  VALORES
  REGRAS_RETORNO
  PREPARO_EXAME
  OUTRO

  @@map("clinic_knowledge_category")
}

/// Base de conhecimento estruturada por clínica — corpo clínico, horários,
/// convênios, valores, regras de retorno, preparo de exames. Cada entrada
/// ativa entra literalmente no prompt do atendente de IA e do Copilot (ver
/// buildClinicKnowledgeContext em clinic-knowledge.ts), pra eliminar risco de
/// alucinação sobre preço/procedimento: a IA consulta isso, não inventa.
/// Escala pequena de propósito (uma clínica tem dezenas de entradas, não
/// milhares) — cabe inteira no prompt, sem precisar de busca vetorial/RAG de
/// verdade.
model ClinicKnowledgeEntry {
  id        String                  @id @default(cuid())
  clinicId  String                  @map("clinic_id")
  category  ClinicKnowledgeCategory
  title     String
  content   String                  @db.Text
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, active])
  @@map("clinic_knowledge_entries")
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  procedures Procedure[]

  @@map("specialties")
}

model Procedure {
  id                      String            @id @default(cuid())
  specialtyId             String?           @map("specialty_id")
  name                    String            @unique
  category                ProcedureCategory
  tussCode                String?           @map("tuss_code")
  description             String?
  preparationInstructions String?           @map("preparation_instructions")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  specialty        Specialty?        @relation(fields: [specialtyId], references: [id])
  clinicProcedures ClinicProcedure[]

  @@map("procedures")
}

model ClinicProcedure {
  id                  String          @id @default(cuid())
  clinicId            String          @map("clinic_id")
  procedureId         String          @map("procedure_id")
  price               Decimal         @db.Decimal(10, 2)
  promotionalPrice    Decimal?        @map("promotional_price") @db.Decimal(10, 2)
  requiresAppointment Boolean         @default(true) @map("requires_appointment")
  appointmentType     AppointmentType @default(SCHEDULED) @map("appointment_type")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  procedure    Procedure     @relation(fields: [procedureId], references: [id])
  appointments Appointment[]

  @@unique([clinicId, procedureId])
  @@map("clinic_procedures")
}

model Appointment {
  id                  String            @id @default(cuid())
  patientName         String            @map("patient_name")
  patientPhone        String            @map("patient_phone")
  patientCpf          String            @map("patient_cpf")
  clinicProcedureId   String            @map("clinic_procedure_id")
  date                DateTime          @db.Date
  timeSlot            String?           @map("time_slot")
  status              AppointmentStatus @default(PENDING)
  paymentMethod       String?           @map("payment_method")
  notes               String?
  affiliateId         String?           @map("affiliate_id")
  affiliateCommission Decimal?          @map("affiliate_commission") @db.Decimal(10, 2)
  commissionReleased  Boolean           @default(false) @map("commission_released")
  reminderSentAt      DateTime?         @map("reminder_sent_at")
  reminderStatus      String?           @default("PENDING") @map("reminder_status")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  clinicProcedure ClinicProcedure @relation(fields: [clinicProcedureId], references: [id])
  affiliate       Affiliate?      @relation(fields: [affiliateId], references: [id])

  @@index([clinicProcedureId, date])
  @@index([affiliateId])
  @@map("appointments")
}

model Affiliate {
  id          String          @id @default(cuid())
  name        String
  email       String?
  phone       String          @unique
  pixKey      String          @map("pix_key")
  pixType     PixKeyType      @map("pix_type")
  city        String
  code        String          @unique
  status      AffiliateStatus @default(PENDING)
  totalEarned Decimal         @default(0) @map("total_earned") @db.Decimal(10, 2)
  totalPaid   Decimal         @default(0) @map("total_paid") @db.Decimal(10, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  appointments Appointment[]
  payments     AffiliatePayment[]

  @@map("affiliates")
}

model AffiliatePayment {
  id          String   @id @default(cuid())
  affiliateId String   @map("affiliate_id")
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@map("affiliate_payments")
}

model Contact {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique
  cpf            String?
  photoUrl       String?   @map("photo_url")
  photoUpdatedAt DateTime? @map("photo_updated_at")
  /// Preenchido quando a pessoa responde "sair"/"parar"/"cancelar" (ver route.ts do
  /// webhook) — permanente e vale pra qualquer clínica, nunca mais entra em disparo
  /// em massa (ver src/lib/broadcast.ts) enquanto isso estiver preenchido.
  optedOutOfBroadcastsAt DateTime? @map("opted_out_of_broadcasts_at")
  /// Entidade (empresa cliente) do GLPI vinculada a este contato — só usado pelo TIVDC,
  /// que atende várias empresas clientes de TI (ver abrirChamadoSuporte em ai-tools.ts).
  /// Sem isso, todo chamado aberto pela IA caía na Entidade raiz do GLPI, sem separar
  /// por empresa. Cadastrado uma vez pelo atendente, reaproveitado em todo chamado futuro.
  glpiEntityId   Int?      @map("glpi_entity_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("contacts")
}

model Conversation {
  id               String                  @id @default(cuid())
  clinicId         String                  @map("clinic_id")
  contactId        String                  @map("contact_id")
  assignedUserId   String?                 @map("assigned_user_id")
  status           ConversationStatus      @default(OPEN)
  tags             String[]                @default([])
  channel          ConversationChannel     @default(WHATSAPP)
  department       ConversationDepartment  @default(RECEPCAO)
  funnelStage      ConversationFunnelStage @default(NOVOS) @map("funnel_stage")
  estimatedValue   Decimal?                @map("estimated_value") @db.Decimal(10, 2)
  resolutionReason String?                 @map("resolution_reason")
  resolutionNotes  String?                 @map("resolution_notes")
  resolvedAt       DateTime?               @map("resolved_at")
  resolvedByUserId String?                 @map("resolved_by_user_id")
  lastMessageAt    DateTime?               @map("last_message_at")
  /// `null` = atribuição "não vista" pelo atendente (transferência ou atribuição manual
  /// do admin) — dispara selo/notificação até ele abrir a conversa. Preenchido na hora
  /// quando o próprio atendente se atribui (já está olhando). Ver src/lib/conversation-assignment.ts.
  assignmentSeenAt DateTime?               @map("assignment_seen_at")
  /// Estado do consentimento LGPD pra atendimento automatizado por IA (ver
  /// src/lib/ai-attendant.ts). Por conversa, não por Contact — o mesmo paciente pode
  /// falar com clínicas diferentes e o consentimento é específico daquele atendimento.
  aiConsentStatus  AiConsentStatus         @default(NOT_ASKED) @map("ai_consent_status")
  /// true só depois do consentimento aceito; volta a false automaticamente se o paciente
  /// pedir humano, bater gatilho de escalação, ou um atendente responder manualmente.
  aiEnabled        Boolean                 @default(false) @map("ai_enabled")
  /// Fixada no topo da fila pelo atendente (menu do card) — só reordena dentro do
  /// mesmo nível de QUEUE_STATE_PRIORITY (ver inbox-layout.tsx), nunca por cima de
  /// urgência clínica ou "sem dono".
  pinned           Boolean                 @default(false)
  /// Suprime som/notificação desktop de mensagem nova (ver chat-crm-app.tsx) — não
  /// esconde o badge de não lida. Null = não silenciada. "Sempre" grava uma data bem
  /// no futuro em vez de precisar de mais um campo boolean.
  mutedUntil       DateTime?               @map("muted_until")
  /// Tirada da fila ativa (não aparece em Todas/Minhas/Não Atribuídas/Finalizadas, só
  /// na aba "Arquivadas") sem depender do status de atendimento. Zerada automaticamente
  /// quando chega mensagem nova do paciente (ver webhook) — nunca deixa uma mensagem
  /// de verdade escondida numa conversa arquivada e esquecida.
  archivedAt       DateTime?               @map("archived_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  clinic       Clinic             @relation(fields: [clinicId], references: [id])
  contact      Contact            @relation(fields: [contactId], references: [id])
  assignedUser User?              @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages     Message[]
  aiLogs       AiInteractionLog[]
  triages      MessageTriage[]
  qualityAudit ConversationQualityAudit?

  @@index([clinicId, status])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  content        String
  status         MessageStatus    @default(PENDING)
  type           MessageType      @default(TEXT)
  senderUserId   String?          @map("sender_user_id")
  attachmentName String?          @map("attachment_name")
  attachmentSize String?          @map("attachment_size")
  audioDuration  String?          @map("audio_duration")
  /// Caminho no bucket privado do Supabase Storage (não é URL pública) — ver src/lib/whatsapp-media.ts
  mediaPath      String?          @map("media_path")
  mimeType       String?          @map("mime_type")
  readAt         DateTime?        @map("read_at")
  /// ID da mensagem no WhatsApp (Baileys key.id, ex: "3EB0305D...") — usado pra
  /// casar os acks de entrega/leitura (webhook "messages.update") com esta linha.
  whatsappKeyId  String?          @unique @map("whatsapp_key_id")
  /// Preenchido quando o WhatsApp avisa (evento messages.delete) que essa mensagem
  /// foi apagada — mantém o conteúdo original no banco, só marca pra exibição.
  deletedAt      DateTime?        @map("deleted_at")
  /// Preenchido quando um atendente edita o texto já enviado (ver canEditMessage
  /// em src/lib/message-edit.ts) — `content` já reflete o texto novo, isso só
  /// serve pra exibir o selo "editada" (mesma UX do WhatsApp).
  editedAt       DateTime?        @map("edited_at")
  /// Transcrição gerada sob demanda (botão "Transcrever" no balão de áudio, ver
  /// transcribeMessageAudio em src/actions/inbox.ts) — null até a atendente pedir.
  /// Guardado pra não pagar de novo pela mesma transcrição toda vez que reabre a conversa.
  transcription  String?          @db.Text
  /// Dados de nota fiscal (cpf/endereco/dependentes/valor) extraídos sob demanda de uma
  /// mensagem de texto do paciente (botão "Extrair dados", ver extractInvoiceData em
  /// src/lib/invoice-extraction.ts) — null até a atendente pedir. Mesmo motivo de cache
  /// de `transcription`: não pagar de novo pela mesma extração ao reabrir a conversa.
  extractedInvoiceData Json?       @map("extracted_invoice_data")
  /// Mensagem que esta responde/cita (botão "Responder" no balão, ou resposta citada
  /// no WhatsApp de verdade — ver contextInfo.stanzaId no webhook). Null quando a
  /// mensagem citada nunca existiu no nosso banco (ex: de antes da conversa) — nunca
  /// bloqueia o recebimento/envio por causa disso.
  quotedMessageId String?         @map("quoted_message_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation  Conversation @relation(fields: [conversationId], references: [id])
  senderUser    User?        @relation(fields: [senderUserId], references: [id])
  quotedMessage Message?     @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy      Message[]    @relation("MessageQuote")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CannedResponse {
  id        String   @id @default(cuid())
  clinicId  String?  @map("clinic_id")
  shortcut  String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, shortcut])
  @@map("canned_responses")
}

/// contactName e email são opcionais pra dar suporte a leads importados de fontes
/// que não têm essa informação (ex: Google Maps via extensão de scraping, que só
/// traz dados do negócio, não de uma pessoa) — o formulário público continua
/// exigindo os dois (ver submitPartnerLeadSchema), só o cadastro/importação feitos
/// pelo admin (ver adminPartnerLeadSchema) que aceitam sem.
model PartnerLead {
  id           String            @id @default(cuid())
  clinicName   String            @map("clinic_name")
  contactName  String?           @map("contact_name")
  phone        String
  email        String?
  neighborhood String
  specialties  String
  notes        String?
  status       PartnerLeadStatus @default(NEW)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("partner_leads")
}

/// Singleton (1 linha só, id fixo "singleton") — controla o disparo automático de
/// contato via IA pros leads de parceria (ver src/lib/ai-lead-outreach.ts). Fica
/// desligado até o admin ativar em /admin/leads: nunca começa a mandar mensagem
/// sozinho só por existir a funcionalidade no código.
model AiOutreachState {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  /// Só é lido quando `enabled`. Recalculado a cada envio (agora + 4~6min
  /// aleatório) — é o que faz o intervalo ser "por volta de 5 minutos", não
  /// cravado, pra não parecer disparo robótico.
  nextRunAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_outreach_state")
}

enum MspLeadStatus {
  NEW
  CONTACTED
  REPLIED
  NOT_INTERESTED

  @@map("msp_lead_status")
}

/// Lead de prospecção do próprio negócio de suporte de TI da TIVDC (MSP) — não confundir
/// com PartnerLead (clínica candidata a virar parceira do marketplace Conecta Saúde,
/// domínio totalmente diferente: fechar um MspLead não cria nenhuma Clinic). Fonte
/// original: TIVDC/MSP (fora deste repo) — ver msp-lead-outreach.ts.
model MspLead {
  id        String        @id @default(cuid())
  name      String
  segment   String?
  city      String?       @default("Vitória da Conquista")
  channel   String?
  phone     String
  notes     String?
  status    MspLeadStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("msp_leads")
}

/// Singleton (1 linha só, id fixo "singleton") — controla o disparo automático de
/// primeiro contato pros leads de MSP (ver src/lib/msp-lead-outreach.ts). Mesmo padrão
/// de AiOutreachState; fica desligado até o admin ativar em /admin/leads-msp.
model MspOutreachState {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  nextRunAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("msp_outreach_state")
}

model WebhookLog {
  id           String   @id @default(cuid())
  event        String
  payload      Json
  status       String
  responseCode Int?     @map("response_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

/// Registro de auditoria de cada troca feita pelo atendente de IA (Art. 18 LGPD —
/// rastreabilidade). Gravado tanto quando a IA responde quanto quando ela escalona
/// pra humano (nesse caso aiResponse fica null e escalated/escalationReason preenchidos).
model AiInteractionLog {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  userMessage      String   @db.Text @map("user_message")
  aiResponse       String?  @db.Text @map("ai_response")
  escalated        Boolean  @default(false)
  escalationReason String?  @map("escalation_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("ai_interaction_logs")
}

/// Auditoria de triagem de urgência clínica (ver matchEscalationTrigger em
/// ai-attendant.ts, usado como o classificador de red flags aqui) — roda em TODA
/// mensagem recebida de TODA clínica, independente de a IA estar ativa ou não
/// (antes só rodava dentro do fluxo de IA, então clínica sem IA ativa — Urolaser,
/// Santa Clara, RC — nunca tinha esse alerta). Vira tag na conversa (ver
/// URGENCY_TAG) pra aparecer na fila; esta tabela é só o histórico/auditoria.
model MessageTriage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  messageContent String   @db.Text @map("message_content")
  redFlags       String[] @map("red_flags")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("message_triage")
}

/// Gerado uma vez por conversa, ao finalizar o atendimento (ver analyzeConversationQuality
/// em conversation-quality.ts) — nunca pelo webhook nem em tempo real. firstResponseSec/
/// resolutionSec são aritmética pura de timestamp (sem IA); sentiment/summary/
/// complianceNotes vêm de uma chamada de IA opcional (ficam null sem OPENAI_API_KEY).
model ConversationQualityAudit {
  id               String   @id @default(cuid())
  conversationId   String   @unique @map("conversation_id")
  /// "POSITIVO" | "NEUTRO" | "NEGATIVO"
  sentiment        String?
  summary          String?  @db.Text
  complianceNotes  String?  @db.Text @map("compliance_notes")
  firstResponseSec Int?     @map("first_response_sec")
  resolutionSec    Int?     @map("resolution_sec")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("conversation_quality_audits")
}

enum BroadcastCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED

  @@map("broadcast_campaign_status")
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPT_OUT

  @@map("broadcast_recipient_status")
}

/// Campanha de disparo em massa de WhatsApp (ex: aviso pra lista de pacientes da
/// Urolaser). Roda através da mesma instância dedicada da clínica, processada aos
/// poucos pelo cron em src/app/api/cron/broadcast-dispatch — nunca de uma vez só,
/// pra não parecer spam e arriscar banimento do número (ver src/lib/broadcast.ts).
model BroadcastCampaign {
  id              String                  @id @default(cuid())
  clinicId        String                  @map("clinic_id")
  name            String
  messageTemplate String                  @db.Text @map("message_template")
  /// Caminho no bucket privado do Supabase Storage (mesmo bucket do inbox, ver
  /// src/lib/whatsapp-media.ts) — null quando a campanha é só texto.
  imagePath       String?                 @map("image_path")
  imageMimeType   String?                 @map("image_mime_type")
  status          BroadcastCampaignStatus @default(DRAFT)
  createdByUserId String                  @map("created_by_user_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  clinic     Clinic               @relation(fields: [clinicId], references: [id])
  recipients BroadcastRecipient[]

  @@map("broadcast_campaigns")
}

model BroadcastRecipient {
  id           String                   @id @default(cuid())
  campaignId   String                   @map("campaign_id")
  phone        String
  /// Colunas extras do CSV (nome, procedimento, data...) usadas como {{variavel}}
  /// no messageTemplate — ver applyBroadcastVariables em src/lib/broadcast.ts.
  variables    Json
  status       BroadcastRecipientStatus @default(PENDING)
  sentAt       DateTime?                @map("sent_at")
  errorMessage String?                  @map("error_message")
  createdAt    DateTime                 @default(now()) @map("created_at")

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, status])
  @@map("broadcast_recipients")
}

model ChatAutomation {
  id           String   @id @default(cuid())
  keyword      String   @unique
  responseText String   @map("response_text")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("chat_automations")
}
