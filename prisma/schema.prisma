generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer/Supavisor, porta 6543) — usado em runtime. Sem isso, cada
  // invocação serverless podia abrir sua própria conexão direta e estourar o limite
  // de conexões simultâneas do Postgres sob tráfego mais alto.
  url       = env("DATABASE_URL")
  // Direta (porta 5432) — só pra migrations, que precisam de prepared statements/DDL
  // que o pgbouncer em modo transaction não suporta.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CLINIC
  PATIENT

  @@map("user_role")
}

enum ProcedureCategory {
  CONSULTATION
  EXAM
  SURGERY

  @@map("procedure_category")
}

enum AppointmentType {
  SCHEDULED
  ARRIVAL_ORDER

  @@map("appointment_type")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED

  @@map("conversation_status")
}

enum AiConsentStatus {
  NOT_ASKED
  PENDING
  ACCEPTED
  DECLINED

  @@map("ai_consent_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

enum PartnerLeadStatus {
  NEW
  CONTACTED
  PARTNER
  REJECTED

  @@map("partner_lead_status")
}

enum PixKeyType {
  CPF
  EMAIL
  PHONE
  RANDOM

  @@map("pix_key_type")
}

enum AffiliateStatus {
  ACTIVE
  PENDING
  SUSPENDED

  @@map("affiliate_status")
}

enum ContactChannel {
  WHATSAPP
  INSTAGRAM

  @@map("contact_channel")
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  WEBCHAT

  @@map("conversation_channel")
}

enum ConversationDepartment {
  RECEPCAO
  AGENDAMENTO
  FINANCEIRO

  @@map("conversation_department")
}

enum ConversationFunnelStage {
  NOVOS
  TRIAGEM
  ORCAMENTO
  AGENDADO

  @@map("conversation_funnel_stage")
}

enum MessageType {
  TEXT
  AUDIO
  INTERNAL_NOTE
  ATTACHMENT
  /// Cartão de contato nativo do WhatsApp (vCard) — hoje só o contato da própria
  /// clínica, sem mediaPath: o texto formatado (nome + telefone) fica em content.
  CONTACT

  @@map("message_type")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  role               UserRole @default(PATIENT)
  passwordHash       String   @map("password_hash")
  clinicId           String?  @map("clinic_id")
  maxConcurrentChats Int      @default(5) @map("max_concurrent_chats")
  /// false = login só de gerência: não aparece pra atribuir/transferir, não recebe conversa automática nem entra no desempenho da equipe.
  isAttendant        Boolean  @default(true) @map("is_attendant")
  /// Gestão: vê Relatórios e Configurações (preços, horários, ticket, regras, investimento).
  /// Recepção (false) usa chat, agenda, pacientes, CRM e disparos. Ver requireClinicManager.
  isManager          Boolean  @default(false) @map("is_manager")
  /// RECEPCAO | MARKETING | GESTAO (src/lib/clinic-permissions.ts). isManager = espelho de GESTAO.
  clinicRole         String   @default("RECEPCAO") @map("clinic_role")
  /// Função MEDICO: nome do médico como vem da agenda (ponte/Conecta) — filtra "Meus pacientes".
  doctorName         String?  @map("doctor_name")
  active             Boolean  @default(true)
  /// Sobe a cada troca de senha / "encerrar sessões" — JWT com versão antiga deixa de valer.
  sessionVersion     Int      @default(0) @map("session_version")
  /// Segredo TOTP (verificação em duas etapas), criptografado (token-crypto). Vale só com totpEnabledAt.
  totpSecret         String?  @map("totp_secret")
  totpEnabledAt      DateTime? @map("totp_enabled_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  assignedConversations Conversation[]            @relation("ConversationAssignee")
  stageChanges          ConversationStageChange[]
  sentMessages          Message[]

  @@map("users")
}

model Clinic {
  id                         String   @id @default(cuid())
  name                       String
  tradeName                  String   @map("trade_name")
  cnpj                       String   @unique
  phone                      String?
  whatsapp                   String?
  address                    String
  neighborhood               String
  city                       String
  active                     Boolean  @default(true)
  /// Clínicas parceiras que usam só o CRM/WhatsApp (ex: modelo "ferramenta
  /// grátis + comissão por agendamento concluído") mas não têm vitrine no
  /// marketplace público — não aparecem em busca, home ou /clinicas.
  listedInMarketplace        Boolean  @default(true) @map("listed_in_marketplace")
  /// Mensagem automática enviada uma única vez, no primeiro contato de um
  /// cliente novo (primeira Conversation dele com essa clínica). Cada clínica
  /// liga/desliga e escreve a sua — não dispara em conversas já existentes,
  /// mesmo resolvidas, pra não parecer robótico com quem já é conhecido.
  welcomeMessageEnabled      Boolean  @default(false) @map("welcome_message_enabled")
  welcomeMessageText         String?  @map("welcome_message_text")
  /// Despedida enviada sozinha ao finalizar o atendimento (src/lib/closing-message.ts).
  /// Gestão liga em /clinic/ia; null no texto = DEFAULT_CLOSING_MESSAGE.
  /// Responde sozinho "onde fica?" com endereço + link do Maps (src/lib/welcome-message.ts).
  addressReplyEnabled        Boolean  @default(false) @map("address_reply_enabled")
  closingMessageEnabled      Boolean  @default(false) @map("closing_message_enabled")
  closingMessageText         String?  @map("closing_message_text")
  commissionRate             Decimal  @map("commission_rate") @db.Decimal(5, 2)
  rating                     Float    @default(0)
  reviewCount                Int      @default(0) @map("review_count")
  businessHours              Json?    @map("business_hours")
  /// Ticket médio de consulta particular — usado no Faturamento Estimado / Receita
  /// Protegida do /clinic/relatorio quando o procedimento não tem preço (ex: agendamentos
  /// do Firebird, que caem num procedimento genérico). Null = sem estimativa.
  /// Responsável técnico (CFM: publicidade médica identifica nome + CRM) — vai no rodapé
  /// das campanhas de marketing; sem ele a campanha não inicia.
  technicalDirectorName      String?  @map("technical_director_name")
  technicalDirectorCrm       String?  @map("technical_director_crm")
  googleReviewUrl            String?  @map("google_review_url")
  defaultTicket              Decimal? @map("default_ticket") @db.Decimal(10, 2)
  /// Códigos de paciente do sistema da clínica (PACIENTE.CODIGOPAC no Firebird) que nunca
  /// entram em campanha pelo público "Pacientes do sistema da clínica" — ex: cadastro com
  /// sexo errado. Ver buildCampaignAudience em src/lib/campaign-audience.ts.
  campaignExcludedPatientIds Int[]    @default([]) @map("campaign_excluded_patient_ids")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  users                User[]
  clinicProcedures     ClinicProcedure[]
  conversations        Conversation[]
  cannedResponses      CannedResponse[]
  whatsappInstance     WhatsappInstance?
  whatsappCloudAccount WhatsappCloudAccount?
  campaignSpends       CampaignSpend[]
  contactProfiles      ContactClinicProfile[]
  hospitalIntegration  HospitalIntegration?
  aiAttendantConfig    AiAttendantConfig?
  broadcastCampaigns   BroadcastCampaign[]
  automationRules      AutomationRule[]
  tagAutomations       TagAutomation[]
  receptionTasks       ReceptionTask[]
  insuranceSettings    ClinicInsuranceSettings?
  channelConsents      ChannelConsent[]
  bridgeReminderLogs   BridgeReminderLog[]
  knowledgeEntries     ClinicKnowledgeEntry[]
  acquisitionRules     AcquisitionRule[]
  instagramAccount     InstagramAccount?

  /// Vaga aberta (cancelou/faltou) é oferecida sozinha pelo WhatsApp à lista de espera.
  autoWaitlistOffer Boolean @default(false) @map("auto_waitlist_offer")
  /// Marca a conversa com "🚨 Urgência Clínica" quando o paciente relata sintoma grave (gestão liga/desliga).
  urgencyTagEnabled Boolean @default(false) @map("urgency_tag_enabled")
  /// Fora do expediente, a IA completa o pedido de marcação com o paciente (src/lib/after-hours-booking.ts).
  afterHoursBookingEnabled Boolean @default(false) @map("after_hours_booking_enabled")
  /// Nível 1 do 4.1: a IA também adianta o pedido no horário comercial, depois de 5 min sem resposta.
  bookingAssistEnabled     Boolean @default(false) @map("booking_assist_enabled")
  /// Ponto da clínica pro QR de chegada no celular (src/lib/geo-fence.ts). Null = sem trava.
  arrivalLat       Float?  @map("arrival_lat")
  arrivalLng       Float?  @map("arrival_lng")
  arrivalRadiusM   Int     @default(150) @map("arrival_radius_m")

  @@map("clinics")
}

enum WhatsappInstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED

  @@map("whatsapp_instance_status")
}

/// Instância Evolution API exclusiva de uma clínica (ex: Santa Clara) — usada só
/// no atendimento humano via chat, nunca nas automações de agendamento do
/// marketplace (que continuam sempre na instância global via env vars).
model WhatsappInstance {
  id            String                 @id @default(cuid())
  clinicId      String                 @unique @map("clinic_id")
  apiUrl        String                 @map("api_url")
  apiKey        String                 @map("api_key")
  instanceName  String                 @unique @map("instance_name")
  status        WhatsappInstanceStatus @default(DISCONNECTED)
  lastCheckedAt DateTime?              @map("last_checked_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("whatsapp_instances")
}

/// Número da clínica conectado à API oficial do WhatsApp (Cloud API) via Embedded
/// Signup / coexistência — separado da WhatsappInstance (Evolution) pra migração ser
/// gradual. `active` só liga depois de testado; enquanto false, a clínica segue na Evolution.
model WhatsappCloudAccount {
  id                       String   @id @default(cuid())
  clinicId                 String   @unique @map("clinic_id")
  wabaId                   String   @map("waba_id")
  phoneNumberId            String   @unique @map("phone_number_id")
  displayPhoneNumber       String?  @map("display_phone_number")
  /// Token de integração do negócio (troca do código do Embedded Signup) — só servidor,
  /// criptografado em repouso ("enc:v1:…", ver src/lib/token-crypto.ts).
  accessToken              String   @map("access_token")
  /// Nome verificado do número na Meta (verified_name).
  verifiedName             String?  @map("verified_name")
  /// PIN de 6 dígitos da verificação em duas etapas usado no /register (número novo,
  /// sem coexistência) — criptografado, necessário pra registrar de novo.
  twoStepPin               String?  @map("two_step_pin")
  /// Modelo aprovado usado no lembrete D-1 (fora da janela de 24 h só modelo sai).
  /// Variáveis na ordem: {{1}} nome, {{2}} data, {{3}} horário, {{4}} médico/procedimento.
  reminderTemplateName     String?  @map("reminder_template_name")
  reminderTemplateLanguage String?  @map("reminder_template_language")
  coexistence              Boolean  @default(false)
  active                   Boolean  @default(false)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("whatsapp_cloud_accounts")
}

/// Config da integração com o sistema hospitalar da clínica (bridge Node.js que fala
/// com o banco Firebird dela) — uma linha por clínica, editável via /admin/clinicas.
/// Presença + `active: true` é o sinal de "essa clínica usa o bridge, não o catálogo
/// do marketplace" (ver hasHospitalBridgeIntegration em src/lib/hospital-bridge.ts).
model HospitalIntegration {
  id                   String    @id @default(cuid())
  clinicId             String    @unique @map("clinic_id")
  apiUrl               String    @map("api_url")
  apiToken             String    @map("api_token")
  active               Boolean   @default(true)
  /// Quando true, o lembrete D-1 pula sábado/domingo como dia-alvo e joga pro
  /// próximo dia útil (ex: sexta manda lembrete de segunda, não de sábado) — pra
  /// clínicas que não atendem fim de semana. Ver nextReminderTargetDate em
  /// bridge-reminder.ts. Default false: não muda o comportamento de clínica nenhuma
  /// só por existir a coluna.
  skipWeekendReminders Boolean   @default(false) @map("skip_weekend_reminders")
  /// Lembretes D-1 suspensos até esta data (ex: número restrito pela Meta em 06/10/2026).
  remindersPausedUntil DateTime? @map("reminders_paused_until")
  lastCheckedAt        DateTime? @map("last_checked_at")
  lastCheckOk          Boolean?  @map("last_check_ok")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("hospital_integrations")
}

/// Controla quais agendamentos do bridge (Firebird) já receberam o lembrete D-1
/// automático (ver dispatchBridgeReminders) — evita mandar duplicado se o cron
/// rodar mais de uma vez no mesmo dia. bridgeNumero é o MARCACAO.NUMERO real da
/// clínica, não um id nosso.
model BridgeReminderLog {
  id           String    @id @default(cuid())
  clinicId     String    @map("clinic_id")
  bridgeNumero Int       @map("bridge_numero")
  sentAt       DateTime  @default(now()) @map("sent_at")
  /// Resposta do paciente ao lembrete ("CONFIRMED" | "CANCELLED" | "RESCHEDULE") —
  /// gravada pelo webhook. Null = sem resposta. Base da seção de Confirmações e da
  /// Receita Protegida do /clinic/relatorio.
  /// Telefone pra casar a resposta do paciente com este lembrete (o agendamento do
  /// bridge não existe no nosso banco). Null em lembretes antigos.
  phone        String?
  response     String?
  respondedAt  DateTime? @map("responded_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, bridgeNumero])
  @@index([clinicId, phone])
  @@map("bridge_reminder_logs")
}

/// Config do atendente de IA da clínica (OpenAI) — uma linha por clínica, editável via
/// /admin/clinicas. `instructions` soma com um prompt-base fixo (regras de LGPD: sempre
/// se identificar como IA, nunca dar diagnóstico, sempre oferecer transferência pra
/// humano) definido em src/lib/ai-attendant.ts. Consentimento e escalação são controlados
/// por conversa (ver Conversation.aiConsentStatus/aiEnabled), não por aqui.
model AiAttendantConfig {
  id            String   @id @default(cuid())
  clinicId      String   @unique @map("clinic_id")
  active        Boolean  @default(false)
  instructions  String   @db.Text
  /// Nome de exibição do atendente (ex: "Lara", "TI") — usado na mensagem de
  /// consentimento LGPD (ver buildAiDisclosureMessage) pra soar como uma
  /// apresentação, não um aviso legal seco. Sem isso, cai no texto genérico
  /// "Assistente Virtual da {clínica}".
  assistantName String?  @map("assistant_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("ai_attendant_configs")
}

enum ClinicKnowledgeCategory {
  CORPO_CLINICO
  HORARIO_ATENDIMENTO
  CONVENIOS
  VALORES
  REGRAS_RETORNO
  PREPARO_EXAME
  OUTRO

  @@map("clinic_knowledge_category")
}

/// Base de conhecimento estruturada por clínica — corpo clínico, horários,
/// convênios, valores, regras de retorno, preparo de exames. Cada entrada
/// ativa entra literalmente no prompt do atendente de IA e do Copilot (ver
/// buildClinicKnowledgeContext em clinic-knowledge.ts), pra eliminar risco de
/// alucinação sobre preço/procedimento: a IA consulta isso, não inventa.
/// Escala pequena de propósito (uma clínica tem dezenas de entradas, não
/// milhares) — cabe inteira no prompt, sem precisar de busca vetorial/RAG de
/// verdade.
model ClinicKnowledgeEntry {
  id        String                  @id @default(cuid())
  clinicId  String                  @map("clinic_id")
  category  ClinicKnowledgeCategory
  title     String
  content   String                  @db.Text
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, active])
  @@map("clinic_knowledge_entries")
}

model Specialty {
  id   String @id @default(cuid())
  name String @unique

  procedures Procedure[]

  @@map("specialties")
}

model Procedure {
  id                      String            @id @default(cuid())
  specialtyId             String?           @map("specialty_id")
  name                    String            @unique
  category                ProcedureCategory
  tussCode                String?           @map("tuss_code")
  description             String?
  preparationInstructions String?           @map("preparation_instructions")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  specialty        Specialty?        @relation(fields: [specialtyId], references: [id])
  clinicProcedures ClinicProcedure[]

  @@map("procedures")
}

model ClinicProcedure {
  id                  String          @id @default(cuid())
  clinicId            String          @map("clinic_id")
  procedureId         String          @map("procedure_id")
  price               Decimal         @db.Decimal(10, 2)
  promotionalPrice    Decimal?        @map("promotional_price") @db.Decimal(10, 2)
  requiresAppointment Boolean         @default(true) @map("requires_appointment")
  appointmentType     AppointmentType @default(SCHEDULED) @map("appointment_type")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  procedure    Procedure     @relation(fields: [procedureId], references: [id])
  appointments Appointment[]

  @@unique([clinicId, procedureId])
  @@map("clinic_procedures")
}

model Appointment {
  id                  String            @id @default(cuid())
  patientName         String            @map("patient_name")
  patientPhone        String            @map("patient_phone")
  patientCpf          String            @map("patient_cpf")
  clinicProcedureId   String            @map("clinic_procedure_id")
  date                DateTime          @db.Date
  timeSlot            String?           @map("time_slot")
  status              AppointmentStatus @default(PENDING)
  paymentMethod       String?           @map("payment_method")
  notes               String?
  /// Preenchido manualmente pela recepção (edição inline em /clinic/agendamentos) —
  /// não existe cadastro de médico no sistema, é texto livre. Usado pra montar o
  /// seletor de médico do aviso de remarcação em massa (ver getDistinctDoctorNames
  /// e getAppointmentsByDoctorAndDate em src/actions/clinic.ts).
  doctorName          String?           @map("doctor_name")
  affiliateId         String?           @map("affiliate_id")
  affiliateCommission Decimal?          @map("affiliate_commission") @db.Decimal(10, 2)
  commissionReleased  Boolean           @default(false) @map("commission_released")
  reminderSentAt      DateTime?         @map("reminder_sent_at")
  reminderStatus      String?           @default("PENDING") @map("reminder_status")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  clinicProcedure ClinicProcedure @relation(fields: [clinicProcedureId], references: [id])
  affiliate       Affiliate?      @relation(fields: [affiliateId], references: [id])

  @@index([clinicProcedureId, date])
  @@index([affiliateId])
  @@index([patientPhone])
  @@map("appointments")
}

model Affiliate {
  id          String          @id @default(cuid())
  name        String
  email       String?
  phone       String          @unique
  pixKey      String          @map("pix_key")
  pixType     PixKeyType      @map("pix_type")
  city        String
  code        String          @unique
  status      AffiliateStatus @default(PENDING)
  totalEarned Decimal         @default(0) @map("total_earned") @db.Decimal(10, 2)
  totalPaid   Decimal         @default(0) @map("total_paid") @db.Decimal(10, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  appointments Appointment[]
  payments     AffiliatePayment[]

  @@map("affiliates")
}

model AffiliatePayment {
  id          String   @id @default(cuid())
  affiliateId String   @map("affiliate_id")
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@map("affiliate_payments")
}

model Contact {
  id                     String         @id @default(cuid())
  name                   String
  /// Opcional desde a integração com Instagram Direct — lead que chega por DM não tem
  /// telefone. Continua único quando preenchido. Todo fluxo de WhatsApp (disparo,
  /// lembrete, bridge) precisa tratar null.
  phone                  String?        @unique
  /// Canal em que o contato nasceu — não impede ter conversa em outro canal.
  channel                ContactChannel @default(WHATSAPP)
  /// IGSID (Instagram-scoped ID) — muda por conta de Instagram, por isso único junto
  /// com o canal. Null pra contato de WhatsApp.
  externalId             String?        @map("external_id")
  instagramUsername      String?        @map("instagram_username")
  cpf                    String?
  /// Texto livre, sem cadastro/FK — mesmo padrão de Appointment.doctorName (não existe
  /// tabela de convênios/médicos por paciente no sistema, de propósito). Editável na
  /// aba "Resumo" da ficha do paciente (ver patient-record-sheet.tsx).
  convenio               String?
  preferredDoctor        String?        @map("preferred_doctor")
  /// Todos texto livre/data simples, sem validação de formato — cadastro rápido pela
  /// recepção, não um cadastro civil completo. Editáveis na aba "Resumo Cadastral" da
  /// ficha do paciente (ver patient-record-sheet.tsx).
  rg                     String?
  birthDate              DateTime?      @map("birth_date") @db.Date
  address                String?
  insuranceCardNumber    String?        @map("insurance_card_number")
  /// Observação permanente de texto livre (ex: "paciente idoso, precisa de ajuda pra
  /// locomoção") — diferente de Conversation.tags (rótulos curtos, por atendimento);
  /// isso é por PACIENTE, atravessa qualquer conversa/clínica.
  notes                  String?
  photoUrl               String?        @map("photo_url")
  photoUpdatedAt         DateTime?      @map("photo_updated_at")
  /// Preenchido quando a pessoa responde "sair"/"parar"/"cancelar" (ver route.ts do
  /// webhook) — permanente e vale pra qualquer clínica, nunca mais entra em disparo
  /// em massa (ver src/lib/broadcast.ts) enquanto isso estiver preenchido.
  optedOutOfBroadcastsAt DateTime?      @map("opted_out_of_broadcasts_at")
  /// Entidade (empresa cliente) do GLPI vinculada a este contato — só usado pelo TIVDC,
  /// que atende várias empresas clientes de TI (ver abrirChamadoSuporte em ai-tools.ts).
  /// Sem isso, todo chamado aberto pela IA caía na Entidade raiz do GLPI, sem separar
  /// por empresa. Cadastrado uma vez pelo atendente, reaproveitado em todo chamado futuro.
  glpiEntityId           Int?           @map("glpi_entity_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  conversations  Conversation[]
  clinicProfiles ContactClinicProfile[]

  @@unique([channel, externalId])
  @@map("contacts")
}

model Conversation {
  id                      String                  @id @default(cuid())
  clinicId                String                  @map("clinic_id")
  contactId               String                  @map("contact_id")
  assignedUserId          String?                 @map("assigned_user_id")
  status                  ConversationStatus      @default(OPEN)
  tags                    String[]                @default([])
  channel                 ConversationChannel     @default(WHATSAPP)
  department              ConversationDepartment  @default(RECEPCAO)
  funnelStage             ConversationFunnelStage @default(NOVOS) @map("funnel_stage")
  estimatedValue          Decimal?                @map("estimated_value") @db.Decimal(10, 2)
  resolutionReason        String?                 @map("resolution_reason")
  resolutionNotes         String?                 @map("resolution_notes")
  resolvedAt              DateTime?               @map("resolved_at")
  resolvedByUserId        String?                 @map("resolved_by_user_id")
  lastMessageAt           DateTime?               @map("last_message_at")
  /// `null` = atribuição "não vista" pelo atendente (transferência ou atribuição manual
  /// do admin) — dispara selo/notificação até ele abrir a conversa. Preenchido na hora
  /// quando o próprio atendente se atribui (já está olhando). Ver src/lib/conversation-assignment.ts.
  assignmentSeenAt        DateTime?               @map("assignment_seen_at")
  /// Estado do consentimento LGPD pra atendimento automatizado por IA (ver
  /// src/lib/ai-attendant.ts). Por conversa, não por Contact — o mesmo paciente pode
  /// falar com clínicas diferentes e o consentimento é específico daquele atendimento.
  aiConsentStatus         AiConsentStatus         @default(NOT_ASKED) @map("ai_consent_status")
  /// true só depois do consentimento aceito; volta a false automaticamente se o paciente
  /// pedir humano, bater gatilho de escalação, ou um atendente responder manualmente.
  aiEnabled               Boolean                 @default(false) @map("ai_enabled")
  /// Fixada no topo da fila pelo atendente (menu do card) — só reordena dentro do
  /// mesmo nível de QUEUE_STATE_PRIORITY (ver inbox-layout.tsx), nunca por cima de
  /// urgência clínica ou "sem dono".
  pinned                  Boolean                 @default(false)
  /// Suprime som/notificação desktop de mensagem nova (ver chat-crm-app.tsx) — não
  /// esconde o badge de não lida. Null = não silenciada. "Sempre" grava uma data bem
  /// no futuro em vez de precisar de mais um campo boolean.
  mutedUntil              DateTime?               @map("muted_until")
  /// Tirada da fila ativa (não aparece em Todas/Minhas/Não Atribuídas/Finalizadas, só
  /// na aba "Arquivadas") sem depender do status de atendimento. Zerada automaticamente
  /// quando chega mensagem nova do paciente (ver webhook) — nunca deixa uma mensagem
  /// de verdade escondida numa conversa arquivada e esquecida.
  archivedAt              DateTime?               @map("archived_at")
  /// Canal de aquisição detectado na 1ª mensagem (ver detectAcquisition em
  /// src/lib/acquisition.ts) — fica na conversa, não no Contact, porque o contato é
  /// compartilhado entre clínicas e a origem é por clínica. Null = conversa anterior
  /// ao rastreamento. Editável manualmente pelo Inbox.
  acquisitionChannel      String?                 @map("acquisition_channel")
  /// Intenção do paciente classificada pelo Jev a cada mensagem recebida (ver
  /// src/lib/patient-intent.ts) — a fila do Chat mostra só com confiança alta.
  patientIntent           String?                 @map("patient_intent")
  patientIntentConfidence Float?                  @map("patient_intent_confidence")
  patientIntentAt         DateTime?               @map("patient_intent_at")
  /// Título do anúncio ou texto-chave que casou
  acquisitionDetail       String?                 @map("acquisition_detail")
  /// Marcador (parceiro de marcação) que indicou o paciente — detectado pelo código
  /// "#m-<codigo>" do link pessoal na 1ª mensagem (ver src/lib/marcadores.ts).
  marcadorId              String?                 @map("marcador_id")
  /// Quando a indicação foi registrada (início da contagem no relatório).
  marcadorAt              DateTime?               @map("marcador_at")
  /// ID do anúncio do Meta (externalAdReply.sourceId), pra agrupar por campanha
  acquisitionAdId         String?                 @map("acquisition_ad_id")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  clinic       Clinic                    @relation(fields: [clinicId], references: [id])
  contact      Contact                   @relation(fields: [contactId], references: [id])
  assignedUser User?                     @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages     Message[]
  aiLogs       AiInteractionLog[]
  triages      MessageTriage[]
  qualityAudit ConversationQualityAudit?
  stageChanges ConversationStageChange[]
  receptionTasks ReceptionTask[]
  adClick      AdClick?

  @@index([clinicId, status])
  @@index([contactId])
  @@index([marcadorId])
  @@index([clinicId, lastMessageAt])
  @@index([assignedUserId])
  @@map("conversations")
}

model Message {
  id                    String           @id @default(cuid())
  conversationId        String           @map("conversation_id")
  direction             MessageDirection
  content               String
  status                MessageStatus    @default(PENDING)
  type                  MessageType      @default(TEXT)
  senderUserId          String?          @map("sender_user_id")
  attachmentName        String?          @map("attachment_name")
  attachmentSize        String?          @map("attachment_size")
  audioDuration         String?          @map("audio_duration")
  /// Caminho no bucket privado do Supabase Storage (não é URL pública) — ver src/lib/whatsapp-media.ts
  mediaPath             String?          @map("media_path")
  mimeType              String?          @map("mime_type")
  readAt                DateTime?        @map("read_at")
  /// ID da mensagem no WhatsApp (Baileys key.id, ex: "3EB0305D...") — usado pra
  /// casar os acks de entrega/leitura (webhook "messages.update") com esta linha.
  whatsappKeyId         String?          @unique @map("whatsapp_key_id")
  /// Preenchido quando o WhatsApp avisa (evento messages.delete) que essa mensagem
  /// foi apagada — mantém o conteúdo original no banco, só marca pra exibição.
  deletedAt             DateTime?        @map("deleted_at")
  /// Preenchido quando um atendente edita o texto já enviado (ver canEditMessage
  /// em src/lib/message-edit.ts) — `content` já reflete o texto novo, isso só
  /// serve pra exibir o selo "editada" (mesma UX do WhatsApp).
  editedAt              DateTime?        @map("edited_at")
  /// Transcrição gerada sob demanda (botão "Transcrever" no balão de áudio, ver
  /// transcribeMessageAudio em src/actions/inbox.ts) — null até a atendente pedir.
  /// Guardado pra não pagar de novo pela mesma transcrição toda vez que reabre a conversa.
  transcription         String?          @db.Text
  /// Dados de nota fiscal (cpf/endereco/dependentes/valor) extraídos sob demanda de uma
  /// mensagem de texto do paciente (botão "Extrair dados", ver extractInvoiceData em
  /// src/lib/invoice-extraction.ts) — null até a atendente pedir. Mesmo motivo de cache
  /// de `transcription`: não pagar de novo pela mesma extração ao reabrir a conversa.
  extractedInvoiceData  Json?            @map("extracted_invoice_data")
  /// Documento médico (pedido de exame/receita/carteirinha) extraído e validado sob
  /// demanda (botão "Analisar Documento", ver processMessageDocument em
  /// src/actions/inbox.ts) — guarda { extracted, validation } (ver DocumentReviewData
  /// em src/lib/documents/document-validator.ts). Null até a atendente pedir. Mesmo
  /// motivo de cache de extractedInvoiceData: não pagar de novo pela mesma extração.
  extractedDocumentData Json?            @map("extracted_document_data")
  /// Mensagem que esta responde/cita (botão "Responder" no balão, ou resposta citada
  /// no WhatsApp de verdade — ver contextInfo.stanzaId no webhook). Null quando a
  /// mensagem citada nunca existiu no nosso banco (ex: de antes da conversa) — nunca
  /// bloqueia o recebimento/envio por causa disso.
  quotedMessageId       String?          @map("quoted_message_id")
  /// Emoji com que o paciente reagiu via WhatsApp (webhook reactionMessage) — null
  /// tanto "nunca reagiu" quanto "reagiu e removeu a reação" (mesmo emoji de novo remove).
  contactReaction       String?          @map("contact_reaction")
  /// Emoji com que o atendente reagiu — sincroniza de verdade pro WhatsApp do paciente
  /// via sendWhatsAppReaction, não é só uma marcação interna (ver Message.starredAt).
  agentReaction         String?          @map("agent_reaction")
  /// Marcação pessoal do atendente pra achar mensagens importantes depois — não existe
  /// conceito equivalente no WhatsApp, então isso nunca sincroniza com a Evolution API.
  starredAt             DateTime?        @map("starred_at")
  /// Enviada pela clínica direto do WhatsApp do celular/WhatsApp Web (webhook com
  /// key.fromMe), não pelo painel — senderUserId fica null (não dá pra saber qual
  /// atendente), a UI mostra "Enviada pelo celular".
  sentFromDevice        Boolean          @default(false) @map("sent_from_device")
  createdAt             DateTime         @default(now()) @map("created_at")

  conversation  Conversation @relation(fields: [conversationId], references: [id])
  senderUser    User?        @relation(fields: [senderUserId], references: [id])
  quotedMessage Message?     @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy      Message[]    @relation("MessageQuote")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CannedResponse {
  id        String   @id @default(cuid())
  clinicId  String?  @map("clinic_id")
  shortcut  String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, shortcut])
  @@map("canned_responses")
}

/// contactName e email são opcionais pra dar suporte a leads importados de fontes
/// que não têm essa informação (ex: Google Maps via extensão de scraping, que só
/// traz dados do negócio, não de uma pessoa) — o formulário público continua
/// exigindo os dois (ver submitPartnerLeadSchema), só o cadastro/importação feitos
/// pelo admin (ver adminPartnerLeadSchema) que aceitam sem.
model PartnerLead {
  id           String            @id @default(cuid())
  clinicName   String            @map("clinic_name")
  contactName  String?           @map("contact_name")
  phone        String
  email        String?
  neighborhood String
  specialties  String
  notes        String?
  status       PartnerLeadStatus @default(NEW)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("partner_leads")
}

/// Singleton (1 linha só, id fixo "singleton") — controla o disparo automático de
/// contato via IA pros leads de parceria (ver src/lib/ai-lead-outreach.ts). Fica
/// desligado até o admin ativar em /admin/leads: nunca começa a mandar mensagem
/// sozinho só por existir a funcionalidade no código.
model AiOutreachState {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  /// Só é lido quando `enabled`. Recalculado a cada envio (agora + 4~6min
  /// aleatório) — é o que faz o intervalo ser "por volta de 5 minutos", não
  /// cravado, pra não parecer disparo robótico.
  nextRunAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_outreach_state")
}

enum MspLeadStatus {
  NEW
  CONTACTED
  REPLIED
  NOT_INTERESTED

  @@map("msp_lead_status")
}

/// Lead de prospecção do próprio negócio de suporte de TI da TIVDC (MSP) — não confundir
/// com PartnerLead (clínica candidata a virar parceira do marketplace Conecta Saúde,
/// domínio totalmente diferente: fechar um MspLead não cria nenhuma Clinic). Fonte
/// original: TIVDC/MSP (fora deste repo) — ver msp-lead-outreach.ts.
model MspLead {
  id        String        @id @default(cuid())
  name      String
  segment   String?
  city      String?       @default("Vitória da Conquista")
  channel   String?
  phone     String
  notes     String?
  status    MspLeadStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("msp_leads")
}

/// Singleton (1 linha só, id fixo "singleton") — controla o disparo automático de
/// primeiro contato pros leads de MSP (ver src/lib/msp-lead-outreach.ts). Mesmo padrão
/// de AiOutreachState; fica desligado até o admin ativar em /admin/leads-msp.
model MspOutreachState {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  nextRunAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("msp_outreach_state")
}

model WebhookLog {
  id           String   @id @default(cuid())
  event        String
  payload      Json
  status       String
  responseCode Int?     @map("response_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("webhook_logs")
}

/// Registro de auditoria de cada troca feita pelo atendente de IA (Art. 18 LGPD —
/// rastreabilidade). Gravado tanto quando a IA responde quanto quando ela escalona
/// pra humano (nesse caso aiResponse fica null e escalated/escalationReason preenchidos).
model AiInteractionLog {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  userMessage      String   @map("user_message") @db.Text
  aiResponse       String?  @map("ai_response") @db.Text
  escalated        Boolean  @default(false)
  escalationReason String?  @map("escalation_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("ai_interaction_logs")
}

/// Auditoria de triagem de urgência clínica (ver matchEscalationTrigger em
/// ai-attendant.ts, usado como o classificador de red flags aqui) — roda em TODA
/// mensagem recebida de TODA clínica, independente de a IA estar ativa ou não
/// (antes só rodava dentro do fluxo de IA, então clínica sem IA ativa — Urolaser,
/// Santa Clara, RC — nunca tinha esse alerta). Vira tag na conversa (ver
/// URGENCY_TAG) pra aparecer na fila; esta tabela é só o histórico/auditoria.
model MessageTriage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  messageContent String   @map("message_content") @db.Text
  redFlags       String[] @map("red_flags")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("message_triage")
}

/// Gerado uma vez por conversa, ao finalizar o atendimento (ver analyzeConversationQuality
/// em conversation-quality.ts) — nunca pelo webhook nem em tempo real. firstResponseSec/
/// resolutionSec são aritmética pura de timestamp (sem IA); sentiment/summary/
/// complianceNotes vêm de uma chamada de IA opcional (ficam null sem OPENAI_API_KEY).
model ConversationQualityAudit {
  id               String   @id @default(cuid())
  conversationId   String   @unique @map("conversation_id")
  /// "POSITIVO" | "NEUTRO" | "NEGATIVO"
  sentiment        String?
  summary          String?  @db.Text
  complianceNotes  String?  @map("compliance_notes") @db.Text
  firstResponseSec Int?     @map("first_response_sec")
  resolutionSec    Int?     @map("resolution_sec")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("conversation_quality_audits")
}

enum BroadcastCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED

  @@map("broadcast_campaign_status")
}

enum BroadcastChannel {
  WHATSAPP
  SMS
  EMAIL

  @@map("broadcast_channel")
}

/// Consentimento de marketing por SMS ou e-mail, por clínica e por endereço (decisão de
/// 25/10/2026: o aceite de WhatsApp não vale para esses canais). Só quem tem consentimento
/// e não saiu recebe (src/lib/channel-consent.ts). O link "não quero mais receber" usa o id
/// desta linha assinado (src/lib/unsubscribe-token.ts) e preenche revokedAt.
model ChannelConsent {
  id        String           @id @default(cuid())
  clinicId  String           @map("clinic_id")
  channel   BroadcastChannel
  /// Endereço canônico: e-mail em minúsculas ou 55DDD9XXXXXXXX (ver consentAddress).
  address   String
  consentAt DateTime         @map("consent_at")
  /// De onde veio o aceite (ex.: "ficha de papel 10/2026", "formulário do site").
  source    String?
  revokedAt DateTime?        @map("revoked_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, channel, address])
  @@map("channel_consents")
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPT_OUT

  @@map("broadcast_recipient_status")
}

/// Campanha de disparo em massa de WhatsApp (ex: aviso pra lista de pacientes da
/// Urolaser). Roda através da mesma instância dedicada da clínica, processada aos
/// poucos pelo cron em src/app/api/cron/broadcast-dispatch — nunca de uma vez só,
/// pra não parecer spam e arriscar banimento do número (ver src/lib/broadcast.ts).
model BroadcastCampaign {
  id                    String                  @id @default(cuid())
  clinicId              String                  @map("clinic_id")
  name                  String
  messageTemplate       String                  @map("message_template") @db.Text
  /// Até 2 variações além de messageTemplate; cada destinatário recebe uma, sorteada
  /// (pickBroadcastVariant em src/lib/broadcast-variants.ts) — contra bloqueio de número.
  messageVariants       String[]                @default([]) @map("message_variants")
  /// API oficial: modelo aprovado pela Meta usado no lugar do texto livre (null = Evolution).
  cloudTemplateName     String?                 @map("cloud_template_name")
  cloudTemplateLanguage String?                 @map("cloud_template_language")
  /// Corpo do modelo com {{1}}, {{2}}… — só para prévia e relatório.
  cloudTemplateBody     String?                 @map("cloud_template_body")
  /// O que vai em cada {{n}}: variável da planilha ({{nome}}) e/ou texto fixo.
  cloudTemplateParams   String[]                @default([]) @map("cloud_template_params")
  /// Canal de envio. WHATSAPP é o fluxo original (src/lib/broadcast.ts); SMS e EMAIL são
  /// despachados por src/lib/channel-broadcast.ts e, nesses dois, BroadcastRecipient.phone
  /// guarda o ENDEREÇO do destinatário (número com DDI 55 no SMS, e-mail no EMAIL).
  channel               BroadcastChannel        @default(WHATSAPP)
  /// Assunto do e-mail (só EMAIL); aceita {{variaveis}} como o texto.
  subject               String?
  /// Caminho no bucket privado do Supabase Storage (mesmo bucket do inbox, ver
  /// src/lib/whatsapp-media.ts) — null quando a campanha é só texto.
  imagePath             String?                 @map("image_path")
  imageMimeType         String?                 @map("image_mime_type")
  /// Anexo da campanha = imagem OU documento (PDF, Word, Excel): imagePath/imageMimeType guardam o
  /// arquivo (nomes antigos). Aqui o nome que o paciente vê no WhatsApp (ex.: "Tabela de valores.pdf");
  /// null em campanha antiga só com imagem (ver broadcastMediaFile em src/lib/broadcast-attachment.ts).
  attachmentName        String?                 @map("attachment_name")
  status                BroadcastCampaignStatus @default(DRAFT)
  /// Quando setada, o dispatcher (src/lib/broadcast.ts) aplica essa tag na Conversation
  /// do destinatário logo após o envio bem-sucedido, e reabre a conversa (status OPEN)
  /// pra ela voltar a aparecer na fila — usado pelo aviso de remarcação em massa
  /// (ver RESCHEDULE_PENDING_TAG em conversation-tags.ts). Null pra campanhas comuns.
  tagOnSend             String?                 @map("tag_on_send")
  /// Baixa prioridade (campanha longa, ex.: Outubro Rosa): pausa sozinha enquanto houver
  /// lembrete de confirmação ou outra campanha da clínica na fila (lowPriorityMustYield).
  lowPriority           Boolean                 @default(false) @map("low_priority")
  /// Campanha criada pela régua automática (AutomationRule.id); null = campanha manual.
  automationRuleId      String?                 @map("automation_rule_id")
  createdByUserId       String                  @map("created_by_user_id")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  clinic     Clinic               @relation(fields: [clinicId], references: [id])
  recipients BroadcastRecipient[]

  @@index([automationRuleId])
  @@index([clinicId, status])
  @@map("broadcast_campaigns")
}

/// Convênios aceitos da clínica + resposta automática a "vocês aceitam X?" (roteiro 2.7,
/// src/lib/insurance-reply.ts). Tabela à parte de propósito: não põe coluna em `clinics`.
model ClinicInsuranceSettings {
  clinicId  String   @id @map("clinic_id")
  enabled   Boolean  @default(false)
  accepted  String[] @default([])
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_insurance_settings")
}

/// Tarefa da recepção (/clinic/tarefas): tarefa com prazo e responsável, criada à mão ou
/// por uma automação (`source` = nome da automação). Apagado junto com a conversa (LGPD).
model ReceptionTask {
  id              String    @id @default(cuid())
  clinicId        String    @map("clinic_id")
  conversationId  String?   @map("conversation_id")
  text            String    @db.Text
  dueAt           DateTime? @map("due_at")
  assignedUserId  String?   @map("assigned_user_id")
  doneAt          DateTime? @map("done_at")
  doneByUserId    String?   @map("done_by_user_id")
  createdByUserId String?   @map("created_by_user_id")
  source          String?
  createdAt       DateTime  @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([clinicId, doneAt])
  @@index([conversationId])
  @@map("reception_tasks")
}

/// Automação por tag (src/lib/tag-automations.ts): quando a conversa recebe `tag`, espera
/// `delayHours` e então envia um modelo aprovado (vira campanha de Disparos) ou deixa um
/// lembrete para a recepção (nota interna + tag "🔔 Lembrete").
model TagAutomation {
  id                    String   @id @default(cuid())
  clinicId              String   @map("clinic_id")
  name                  String
  /// TAG (recebeu a tag) | STAGE (entrou na etapa do CRM; `stage` guarda qual, `tag` fica vazio)
  triggerKind           String   @default("TAG") @map("trigger_kind")
  tag                   String
  stage                 String?
  delayHours            Int      @default(0) @map("delay_hours")
  /// ENTRY (conta de quando entrou) | LAST_MESSAGE (conta da última mensagem: "parado há N")
  waitFrom              String   @default("ENTRY") @map("wait_from")
  /// Paciente escreveu depois de entrar na automação: não envia nem lembra.
  stopOnReply           Boolean  @default(false) @map("stop_on_reply")
  /// Aviso de serviço (não propaganda): a campanha nasce com tagOnSend = SERVICE_NOTICE_MARK
  /// e o envio dispensa o aceite de marketing (src/lib/campaign-kind.ts). Exige modelo Utilidade.
  serviceNotice         Boolean  @default(false) @map("service_notice")
  /// Passos depois do primeiro (StoredStep[] em tag-automations.ts). O primeiro são as colunas acima.
  extraSteps            Json     @default("[]") @map("extra_steps")
  /// MESSAGE | REMINDER
  action                String
  /// REVIEW (campanha nasce rascunho, a recepção inicia) | AUTO (já sai enviando)
  mode                  String   @default("REVIEW")
  reminderText          String?  @map("reminder_text") @db.Text
  cloudTemplateName     String?  @map("cloud_template_name")
  cloudTemplateLanguage String?  @map("cloud_template_language")
  cloudTemplateBody     String?  @map("cloud_template_body")
  cloudTemplateParams   String[] @default([]) @map("cloud_template_params")
  active                Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  clinic      Clinic                    @relation(fields: [clinicId], references: [id])
  enrollments TagAutomationEnrollment[]

  @@index([clinicId])
  @@map("tag_automations")
}

/// Uma conversa dentro de uma automação por tag. Sem FK para a conversa de propósito: a
/// entrada é apagada pelo próprio executor quando a tag sai ou a conversa deixa de existir.
model TagAutomationEnrollment {
  id             String    @id @default(cuid())
  automationId   String    @map("automation_id")
  conversationId String    @map("conversation_id")
  /// PENDING | DONE | BASELINE | SKIPPED (ver EnrollmentStatus em tag-automations.ts)
  status         String    @default("PENDING")
  /// Passo que esta conversa está esperando (0 = primeiro).
  stepIndex      Int       @default(0) @map("step_index")
  dueAt          DateTime  @map("due_at")
  doneAt         DateTime? @map("done_at")
  /// Campanha de Disparos em que esta conversa entrou (ação MESSAGE).
  campaignId     String?   @map("campaign_id")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  automation TagAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, conversationId])
  @@index([status, dueAt])
  @@map("tag_automation_enrollments")
}

/// Passo da régua automática (src/lib/automation-rules.ts): todo dia, quem teve a última
/// consulta há `daysAfter` dias vira uma campanha de Disparos (RUNNING, baixa prioridade).
/// Só roda com a API oficial ativa e modelo aprovado (cloudTemplateName).
model AutomationRule {
  id                    String   @id @default(cuid())
  clinicId              String   @map("clinic_id")
  /// POS_CONSULTA | RETORNO | REATIVACAO | ANIVERSARIO | NPS
  kind                  String
  name                  String
  daysAfter             Int      @map("days_after")
  /// Tira quem já tem consulta futura marcada (retorno/reativação).
  requireNoFuture       Boolean  @default(true) @map("require_no_future")
  messageTemplate       String   @map("message_template") @db.Text
  cloudTemplateName     String?  @map("cloud_template_name")
  cloudTemplateLanguage String?  @map("cloud_template_language")
  cloudTemplateBody     String?  @map("cloud_template_body")
  cloudTemplateParams   String[] @default([]) @map("cloud_template_params")
  active                Boolean  @default(false)
  /// Último dia (AAAA-MM-DD, Brasília) em que rodou — evita rodar 2× no mesmo dia.
  lastRunDate           String?  @map("last_run_date")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, kind])
  @@map("automation_rules")
}

model BroadcastRecipient {
  id                String                   @id @default(cuid())
  campaignId        String                   @map("campaign_id")
  phone             String
  /// Colunas extras do CSV (nome, procedimento, data...) usadas como {{variavel}}
  /// no messageTemplate — ver applyBroadcastVariables em src/lib/broadcast.ts.
  variables         Json
  status            BroadcastRecipientStatus @default(PENDING)
  sentAt            DateTime?                @map("sent_at")
  errorMessage      String?                  @map("error_message")
  /// Aviso urgente: a recepção marcou que ligou pro paciente (quem não receberia a
  /// mensagem antes da consulta — ver "Precisam de ligação" em /clinic/disparos).
  calledAt          DateTime?                @map("called_at")
  /// Variação enviada (0 = messageTemplate, 1–2 = messageVariants); null = não enviado.
  variantIndex      Int?                     @map("variant_index")
  /// Id da mensagem no provedor (e-mail: id do Resend) — casa o webhook de entrega.
  providerMessageId String?                  @map("provider_message_id")
  /// DELIVERED | DELAYED | BOUNCED | COMPLAINED (webhook do Resend); null = sem retorno.
  deliveryStatus    String?                  @map("delivery_status")
  deliveryAt        DateTime?                @map("delivery_at")
  createdAt         DateTime                 @default(now()) @map("created_at")

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([phone])
  @@map("broadcast_recipients")
}

model ChatAutomation {
  id           String   @id @default(cuid())
  keyword      String   @unique
  responseText String   @map("response_text")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("chat_automations")
}

/// Texto-chave de campanha (ex: texto pré-preenchido do link do anúncio) → canal de
/// aquisição. Checado contra a 1ª mensagem da conversa, sem diferenciar caixa/acento.
model AcquisitionRule {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  keyword   String
  channel   String
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("acquisition_rules")
}

/// Conta profissional de Instagram da clínica (Instagram API com Instagram Login) —
/// `igUserId` é o `entry.id` que chega no webhook, usado pra achar a clínica. Uma por
/// clínica. Cadastro manual pelo admin por enquanto (sem fluxo OAuth).
model InstagramAccount {
  id             String    @id @default(cuid())
  clinicId       String    @unique @map("clinic_id")
  igUserId       String    @unique @map("ig_user_id")
  username       String?
  accessToken    String    @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("instagram_accounts")
}

/// Histórico de mudança de etapa do funil (N1 — linha do tempo da ficha do paciente).
/// userId null = mudança automática (ex: chatbot). Só registra a partir de 2026-10.
model ConversationStageChange {
  id             String                  @id @default(cuid())
  conversationId String                  @map("conversation_id")
  fromStage      ConversationFunnelStage @map("from_stage")
  toStage        ConversationFunnelStage @map("to_stage")
  userId         String?                 @map("user_id")
  createdAt      DateTime                @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_stage_changes")
}

/// Status marcado à mão pela recepção na Agenda (/clinic/agenda): presente, atendido,
/// falta, confirmado, cancelado. Vale pras marcações da ponte (sistema da clínica, não
/// gravamos lá) e pros agendamentos do Conecta. source = "BRIDGE" (externalId = NUMERO)
/// ou "LOCAL" (externalId = Appointment.id).
model AgendaMark {
  id              String   @id @default(cuid())
  clinicId        String   @map("clinic_id")
  source          String
  externalId      String   @map("external_id")
  date            DateTime @db.Date
  status          String
  /// Telefone do paciente — liga a marcação ao relatório de marcadores (atendidos).
  phone           String?
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, source, externalId])
  @@index([clinicId, date])
  @@map("agenda_marks")
}

/// Parceiro de marcação da clínica (pessoa ou central que manda pacientes). Ver
/// src/lib/marcadores.ts e /clinic/marcadores.
model Marcador {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  name      String
  phone     String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, code])
  @@unique([clinicId, phone])
  @@map("marcadores")
}

/// Motivos de perda que a clínica acrescenta aos padrões do CRM (ver src/lib/loss-reasons.ts).
/// Conversation.resolutionReason guarda "PERDA_CUSTOM:<rótulo>", então remover o motivo
/// daqui não apaga o histórico dos relatórios.
model LossReason {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clinicId, label])
  @@map("loss_reasons")
}

/// Lista de espera da agenda (/clinic/agenda): paciente que aceita uma vaga que abrir.
/// status: WAITING | OFFERED | BOOKED | CANCELLED. period: ANY | MORNING | AFTERNOON.
/// Ver src/lib/waitlist.ts.
model WaitlistEntry {
  id          String    @id @default(cuid())
  clinicId    String    @map("clinic_id")
  patientName String    @map("patient_name")
  phone       String
  doctorName  String?   @map("doctor_name")
  period      String    @default("ANY")
  notes       String?
  status      String    @default("WAITING")
  offeredAt   DateTime? @map("offered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([clinicId, status])
  @@map("waitlist_entries")
}

/// Oferta automática de vaga à lista de espera (src/lib/slot-offer-server.ts). Um por vaga
/// (slotKey = "BRIDGE:123" | "LOCAL:<id>"). Um candidato por vez: entryId/phone/expiresAt
/// = oferta em aberto; triedEntryIds = quem já recebeu. status OPEN | FILLED | EXPIRED.
model SlotOffer {
  id            String    @id @default(cuid())
  clinicId      String    @map("clinic_id")
  slotKey       String    @map("slot_key")
  date          String
  time          String
  doctor        String?
  procedure     String?
  status        String    @default("OPEN")
  entryId       String?   @map("entry_id")
  phone         String?
  offeredAt     DateTime? @map("offered_at")
  expiresAt     DateTime? @map("expires_at")
  triedEntryIds String[]  @default([]) @map("tried_entry_ids")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([clinicId, slotKey])
  @@index([status, expiresAt])
  @@map("slot_offers")
}

/// O que a IA decidiu ou respondeu sozinha (tela /clinic/ia). kind: APPT_CONFIRMED |
/// APPT_CANCELLED | APPT_RESCHEDULE | AI_REPLIED | AI_ESCALATED. Ver src/lib/ai-actions.ts.
model AiActionLog {
  id             String   @id @default(cuid())
  clinicId       String   @map("clinic_id")
  conversationId String   @map("conversation_id")
  kind           String
  summary        String   @db.Text
  confidence     Float?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@map("ai_action_logs")
}

/// CPF/convênio achados numa mensagem do paciente (ver src/lib/patient-data-extraction.ts):
/// só uma sugestão na ficha — a atendente aplica ou descarta, nada vai pro Contact sozinho.
model PatientDataSuggestion {
  id             String   @id @default(cuid())
  conversationId String   @unique @map("conversation_id")
  cpf            String?
  convenio       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("patient_data_suggestions")
}

/// Mensagem sugerida ao mover o card no Kanban para uma etapa (orcamento | agendado).
/// A recepção revisa e envia; ver src/lib/stage-messages.ts.
model StageMessage {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  stage     String
  text      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, stage])
  @@map("stage_messages")
}

/// Mensagens enviadas pelas telas de teste da API oficial (/admin/whatsapp/enviar e
/// /templates) — o status (sent/delivered/read/failed) é atualizado pelo webhook. Base da
/// gravação da análise do app na Meta.
model CloudTestMessage {
  id            String   @id @default(cuid())
  clinicId      String   @map("clinic_id")
  phoneNumberId String   @map("phone_number_id")
  to            String
  kind          String
  body          String   @db.Text
  templateName  String?  @map("template_name")
  wamid         String?  @unique
  status        String   @default("SENDING")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([clinicId, createdAt])
  @@map("cloud_test_messages")
}

/// Investimento informado pela clínica por campanha e mês (relatório "Por campanha":
/// custo por lead, custo por agendamento e retorno). `campaign` = rótulo de
/// campaignLabel (canal + detalhe), `month` = "AAAA-MM".
model CampaignSpend {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  campaign  String
  month     String
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, campaign, month])
  @@map("campaign_spends")
}

/// Tentativa de login com senha errada — base do bloqueio de 15 min após 5 erros
/// (ver src/lib/login-guard.ts). Só falhas; limpas pelo cron de retenção.
model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_failures")
}

/// Dados cadastrais do paciente POR CLÍNICA (auditoria de saúde/LGPD, 20/10/2026): antes
/// ficavam em Contact, compartilhados entre todas as clínicas que falam com o mesmo
/// telefone — uma clínica via CPF, endereço e observações cadastrados por outra. Contact
/// continua com nome/telefone (identidade do WhatsApp); o resto vive aqui.
model ContactClinicProfile {
  id                     String    @id @default(cuid())
  contactId              String    @map("contact_id")
  clinicId               String    @map("clinic_id")
  cpf                    String?
  rg                     String?
  birthDate              DateTime? @map("birth_date") @db.Date
  address                String?
  insuranceCardNumber    String?   @map("insurance_card_number")
  convenio               String?
  preferredDoctor        String?   @map("preferred_doctor")
  notes                  String?
  /// Consentimento para campanhas de marketing DESTA clínica (null = não consentiu).
  marketingConsentAt     DateTime? @map("marketing_consent_at")
  /// De onde veio: "whatsapp" (paciente mandou QUERO RECEBER) | "recepcao" (marcado na ficha).
  marketingConsentSource String?   @map("marketing_consent_source")
  /// Responsável legal (paciente menor de idade): nome, parentesco e telefone.
  guardianName           String?   @map("guardian_name")
  guardianRelationship   String?   @map("guardian_relationship")
  guardianPhone          String?   @map("guardian_phone")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id])

  @@unique([contactId, clinicId])
  @@index([clinicId])
  @@map("contact_clinic_profiles")
}

/// Quem acessou dados de qual paciente (auditoria de saúde/LGPD, 20/10/2026): abrir a
/// conversa, abrir a ficha, editar o cadastro. Leitura repetida do mesmo usuário na mesma
/// conversa só conta 1× por hora (ver src/lib/access-log.ts). Tela: /clinic/acessos (gestão).
model PatientAccessLog {
  id             String   @id @default(cuid())
  clinicId       String   @map("clinic_id")
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  action         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@index([conversationId, userId, createdAt])
  @@map("patient_access_logs")
}

/// Exclusão de dados a pedido do titular (LGPD art. 18) — registro do que foi feito, sem
/// dado pessoal (só ids, telefone mascarado e o motivo). Ver anonymizePatientAdmin.
model DataDeletionRecord {
  id                String   @id @default(cuid())
  clinicId          String   @map("clinic_id")
  conversationId    String   @map("conversation_id")
  maskedPhone       String?  @map("masked_phone")
  reason            String
  messagesDeleted   Int      @map("messages_deleted")
  contactAnonymized Boolean  @map("contact_anonymized")
  performedByUserId String   @map("performed_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("data_deletion_records")
}

/// Fase 1 da jornada do paciente (02/11/2026). Tabelas novas, sem FK pra tabelas
/// existentes (mesmo estilo de PatientAccessLog) — nada muda nas consultas atuais.

/// Link de uso do paciente (ficha prévia, check-in, NPS). Só o SHA-256 do token fica aqui;
/// o token cru vai só na mensagem. Ver src/lib/patient-token.ts.
model PatientToken {
  id                    String    @id @default(cuid())
  clinicId              String    @map("clinic_id")
  kind                  String
  tokenHash             String    @unique @map("token_hash")
  phone                 String?
  contactId             String?   @map("contact_id")
  /// "BRIDGE" (NUMERO no sistema da clínica) ou "LOCAL" (Appointment.id), como AgendaMark.
  appointmentSource     String?   @map("appointment_source")
  appointmentExternalId String?   @map("appointment_external_id")
  appointmentDate       DateTime? @map("appointment_date") @db.Date
  expiresAt             DateTime  @map("expires_at")
  usedAt                DateTime? @map("used_at")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([clinicId, kind, appointmentDate])
  @@index([expiresAt])
  @@map("patient_tokens")
}

/// Modelo da ficha prévia por clínica. Cada edição = nova versão (respostas antigas
/// continuam ligadas à versão que o paciente viu). body = { questions: FormQuestion[] }.
model FormTemplate {
  id        String                @id @default(cuid())
  clinicId  String                @map("clinic_id")
  kind      String                @default("ANAMNESE")
  name      String
  version   Int
  body      Json
  active    Boolean               @default(true)
  createdAt DateTime              @default(now()) @map("created_at")
  responses PatientFormResponse[]

  @@unique([clinicId, kind, version])
  @@map("form_templates")
}

/// Resposta da ficha prévia. answers é JSON criptografado (AES-256-GCM, token-crypto) —
/// dado de saúde (LGPD art. 11). Leitura registrada em PatientAccessLog.
model PatientFormResponse {
  id                    String       @id @default(cuid())
  clinicId              String       @map("clinic_id")
  templateId            String       @map("template_id")
  template              FormTemplate @relation(fields: [templateId], references: [id])
  tokenId               String?      @unique @map("token_id")
  phone                 String?
  contactId             String?      @map("contact_id")
  appointmentSource     String?      @map("appointment_source")
  appointmentExternalId String?      @map("appointment_external_id")
  appointmentDate       DateTime?    @map("appointment_date") @db.Date
  answersEncrypted      String       @map("answers_encrypted")
  consentAcceptanceId   String?      @map("consent_acceptance_id")
  submittedAt           DateTime     @default(now()) @map("submitted_at")

  @@index([clinicId, appointmentDate])
  @@index([clinicId, phone])
  @@map("patient_form_responses")
}

/// Resposta da pesquisa de satisfação (passo NPS da régua, link /p/[token]). Comentário
/// criptografado (texto livre pode trazer dado de saúde).
model NpsResponse {
  id               String   @id @default(cuid())
  clinicId         String   @map("clinic_id")
  tokenId          String?  @unique @map("token_id")
  phone            String?
  score            Int
  commentEncrypted String?  @map("comment_encrypted")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  @@index([clinicId, submittedAt])
  @@map("nps_responses")
}

/// Intervalo de retorno (src/lib/return-interval.ts). kind DOCTOR: key = código do médico
/// no sistema da clínica, label = nome; kind PROCEDURE: key = ClinicProcedure.id.
model ReturnInterval {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  kind      String
  key       String
  label     String
  days      Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, kind, key])
  @@map("return_intervals")
}

/// Pedido de marcação extraído da conversa pela IA (src/lib/booking-request.ts). A recepção
/// marca no sistema da clínica e dá baixa. status: OPEN | SCHEDULED | DISCARDED.
model BookingRequest {
  id              String    @id @default(cuid())
  clinicId        String    @map("clinic_id")
  conversationId  String    @map("conversation_id")
  phone           String?
  patientName     String?   @map("patient_name")
  doctorName      String?   @map("doctor_name")
  procedure       String?
  period          String    @default("ANY")
  preferredDates  String?   @map("preferred_dates")
  notes           String?
  status          String    @default("OPEN")
  handledByUserId String?   @map("handled_by_user_id")
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([clinicId, status])
  @@index([conversationId])
  @@map("booking_requests")
}

/// Termo de consentimento versionado. clinicId null = termo padrão do Conecta.
model ConsentTerm {
  id          String              @id @default(cuid())
  clinicId    String?             @map("clinic_id")
  kind        String
  version     Int
  title       String
  body        String
  publishedAt DateTime            @default(now()) @map("published_at")
  acceptances ConsentAcceptance[]

  @@index([clinicId, kind, version])
  @@map("consent_terms")
}

/// Aceite de um termo (qual versão, quando). IP só como hash.
model ConsentAcceptance {
  id         String      @id @default(cuid())
  termId     String      @map("term_id")
  term       ConsentTerm @relation(fields: [termId], references: [id])
  clinicId   String      @map("clinic_id")
  phone      String?
  contactId  String?     @map("contact_id")
  ipHash     String?     @map("ip_hash")
  userAgent  String?     @map("user_agent")
  acceptedAt DateTime    @default(now()) @map("accepted_at")

  @@index([clinicId, phone])
  @@map("consent_acceptances")
}

/// Auditoria de alterações (quem mudou o quê). changes = auditDiff() — campos sensíveis
/// mascarados. Leituras ficam em PatientAccessLog.
model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String?  @map("clinic_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Painel de chamada da TV da sala de espera (src/lib/tv-call.ts). Link da TV sem login:
/// só o hash do token fica gravado; revogar desliga a TV na hora.
model TvDisplay {
  id         String    @id @default(cuid())
  clinicId   String    @map("clinic_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  /// "TV" (painel de chamada) | "TOTEM" (retirar senha).
  kind       String    @default("TV")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([clinicId])
  @@map("tv_displays")
}

/// Sala fixa de cada médico (chave = doctorKey do nome); dá pra trocar na hora de chamar.
model DoctorRoom {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  doctorKey String   @map("doctor_key")
  doctor    String
  room      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, doctorKey])
  @@map("doctor_rooms")
}

/// Chamadas feitas (histórico do rodapé da TV). Só nome curto/falado, sem telefone;
/// apagadas depois de 24 h.
model PatientCall {
  id             String   @id @default(cuid())
  clinicId       String   @map("clinic_id")
  source         String
  externalId     String   @map("external_id")
  displayName    String   @map("display_name")
  spokenName     String   @map("spoken_name")
  doctor         String?
  room           String?
  attempt        Int      @default(1)
  calledByUserId String?  @map("called_by_user_id")
  /// Chamada de senha do totem ("N012"): a TV mostra e fala a senha, não o nome.
  ticketCode     String?  @map("ticket_code")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@map("patient_calls")
}

/// Senha do totem (src/lib/queue-ticket.ts). Numeração por clínica/dia/tipo (N normal,
/// P preferencial). followTokenHash = QR Code pro paciente acompanhar a fila (/senha/<token>).
/// Serviço da senha do totem (Consulta, Exame, Resultado…): letra própria, ativa/inativa.
model QueueService {
  id        String   @id @default(cuid())
  clinicId  String   @map("clinic_id")
  name      String
  letter    String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clinicId, letter])
  @@map("queue_services")
}

model QueueTicket {
  id                String    @id @default(cuid())
  clinicId          String    @map("clinic_id")
  /// Dia (AAAA-MM-DD, fuso da clínica).
  day               String
  /// Série da numeração (C, CP, E… ou N/P sem serviço) — ver seriesFor.
  series             String    @default("")
  serviceId          String?   @map("service_id")
  serviceName        String?   @map("service_name")
  type              String
  number            Int
  code              String
  status            String    @default("WAITING")
  followTokenHash   String    @unique @map("follow_token_hash")
  /// Consulta de hoje encontrada pelo CPF/telefone digitado (null = sem agendamento).
  patientName       String?   @map("patient_name")
  phone             String?
  doctor            String?
  appointmentSource String?   @map("appointment_source")
  appointmentExtId  String?   @map("appointment_external_id")
  appointmentTime   String?   @map("appointment_time")
  room              String?
  callCount         Int       @default(0) @map("call_count")
  calledAt          DateTime? @map("called_at")
  calledByUserId    String?   @map("called_by_user_id")
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([clinicId, day, series, number])
  @@index([clinicId, day, status])
  @@map("queue_tickets")
}

/// Mídia da TV da sala de espera (src/lib/tv-media.ts): rodízio de YouTube/vídeo/imagem
/// + música (Spotify). Arquivos próprios ficam no bucket privado, prefixo tv/<clinicId>/.
model TvMediaItem {
  id          String   @id @default(cuid())
  clinicId    String   @map("clinic_id")
  kind        String
  /// YOUTUBE/SPOTIFY: link; VIDEO/IMAGE: caminho no Storage.
  source      String
  title       String
  /// Imagem: segundos na tela.
  durationSec Int      @default(15) @map("duration_sec")
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clinicId, position])
  @@map("tv_media_items")
}

/// Processo de um setor da clínica (src/lib/processes.ts): passo a passo que a equipe consulta.
/// status DRAFT (só gestão vê) | PUBLISHED. version sobe a cada edição publicada.
model ClinicProcess {
  id              String            @id @default(cuid())
  clinicId        String            @map("clinic_id")
  sector          String
  title           String
  body            String            @db.Text
  status          String            @default("DRAFT")
  version         Int               @default(1)
  changeNote      String?           @map("change_note")
  updatedByUserId String?           @map("updated_by_user_id")
  publishedAt     DateTime?         @map("published_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  feedback        ProcessFeedback[]

  @@unique([clinicId, sector])
  @@map("clinic_processes")
}

/// Dúvida, opinião ou reclamação da equipe sobre um processo. status NOVA | VISTA | RESOLVIDA.
/// anonymous = a gestão não vê quem mandou (userId fica nulo).
model ProcessFeedback {
  id           String        @id @default(cuid())
  clinicId     String        @map("clinic_id")
  processId    String        @map("process_id")
  userId       String?       @map("user_id")
  kind         String
  text         String        @db.Text
  status       String        @default("NOVA")
  aiAnswer     String?       @map("ai_answer") @db.Text
  managerReply String?       @map("manager_reply") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  process      ClinicProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@map("process_feedback")
}

/// Histórico de entradas no sistema (login certo e errado), para a gestão e o admin.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  clinicId  String?  @map("clinic_id")
  email     String
  success   Boolean
  /// SENHA | BLOQUEADO | INATIVO | CODIGO_2FA (falha) — null no sucesso.
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
  @@map("login_events")
}

/// "Esqueci a senha": link por e-mail, uso único, 1 hora. Guarda só o hash do token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Clique pago que chegou ao site da clínica (gclid/fbclid), enviado pelo track.js do site
/// com consentimento de cookies (ver src/lib/ad-tracking.ts e /api/track/click). Liga-se à
/// conversa quando a 1ª mensagem traz "ref:<token>". Sem IP, sem página, sem referrer.
/// Apagado 90 dias após o clique (cron data-retention) — com ou sem conversa.
model AdClick {
  id             String    @id @default(cuid())
  token          String    @unique
  gclid          String?
  gbraid         String?
  wbraid         String?
  fbclid         String?
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  utmTerm        String?   @map("utm_term")
  conversationId String?   @unique @map("conversation_id")
  matchedAt      DateTime? @map("matched_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversions  AdConversion[]

  @@index([createdAt])
  @@map("ad_clicks")
}

/// Conversão de um clique pago: SCHEDULED (agendou) ou ATTENDED (compareceu). Gravada pelo
/// cron ad-conversions; a Meta recebe pela Conversions API (metaSentAt) e o Google Ads busca
/// a planilha /api/conversions/google-ads. Só evento + identificador de clique.
model AdConversion {
  id         String    @id @default(cuid())
  adClickId  String    @map("ad_click_id")
  kind       String
  occurredAt DateTime  @map("occurred_at")
  metaSentAt DateTime? @map("meta_sent_at")
  metaError  String?   @map("meta_error")
  createdAt  DateTime  @default(now()) @map("created_at")

  adClick AdClick @relation(fields: [adClickId], references: [id], onDelete: Cascade)

  @@unique([adClickId, kind])
  @@map("ad_conversions")
}