# Variáveis para docker-compose.prod.yml.
# Copie para .env.prod, preencha com valores reais e NUNCA comite esse arquivo.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=marcacao
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=marcacao

# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
# URL pública onde a aplicação vai ficar acessível (atrás do Nginx)
NEXTAUTH_URL=https://seu-dominio.exemplo.com

# WhatsApp — opcional. Deixe em branco para rodar sem notificações (ver
# docs/obsidian/03 - APIs e Webhooks n8n.md).
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=
WHATSAPP_WEBHOOK_SECRET=
