DATABASE_URL="postgresql://marcacao:marcacao@localhost:5432/marcacao?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Integração de WhatsApp — deixe vazio/comentado para rodar sem WhatsApp
# (o serviço loga SKIPPED em vez de tentar enviar). "evolution" | "uazapi" | "zapi"
WHATSAPP_PROVIDER="evolution"
WHATSAPP_API_URL="https://sua-instancia-evolution.exemplo.com"
WHATSAPP_API_KEY="sua-api-key"
WHATSAPP_INSTANCE_NAME="marcacao"
# Compartilhado com o provedor para autenticar o webhook de entrada (header x-webhook-token)
WHATSAPP_WEBHOOK_SECRET="replace-with-a-random-secret"

# Bridge do sistema hospitalar (Firebird) da Santa Clara — exposta via Cloudflare Tunnel.
# Deixe vazio pra rodar sem essa integração (a clínica cai no catálogo normal do marketplace).
SANTA_CLARA_API_URL="https://api-santaclara.tivdc.com.br"
SANTA_CLARA_API_TOKEN="token-fornecido-pela-bridge"
