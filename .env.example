DATABASE_URL="postgresql://marcacao:marcacao@localhost:5432/marcacao?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Integração de WhatsApp — deixe vazio/comentado para rodar sem WhatsApp
# (o serviço loga SKIPPED em vez de tentar enviar). "evolution" | "uazapi" | "zapi"
WHATSAPP_PROVIDER="evolution"
WHATSAPP_API_URL="https://sua-instancia-evolution.exemplo.com"
WHATSAPP_API_KEY="sua-api-key"
WHATSAPP_INSTANCE_NAME="marcacao"
# Compartilhado com o provedor para autenticar o webhook de entrada (header x-webhook-token)
WHATSAPP_WEBHOOK_SECRET="replace-with-a-random-secret"

# Integração com sistema hospitalar (bridge Firebird): não é mais configurada aqui.
# Cada clínica tem sua própria integração cadastrada em /admin/clinicas (modal
# "Integração Hospitalar" no card da clínica) — veja src/lib/hospital-bridge.ts.

# Atendente de IA (OpenAI) no WhatsApp — deixe vazio/comentado para desligar a IA em
# todas as clínicas (fica só no fluxo humano normal, mesmo com AiAttendantConfig ativo).
# Cada clínica liga/desliga e escreve suas instruções em /admin/clinicas (modal
# "Atendente de IA") — veja src/lib/ai-attendant.ts.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
